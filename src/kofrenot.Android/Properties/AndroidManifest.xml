<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:installLocation="auto">
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- HTTPS only (network_security_config); no backup of the app's files (its mirrors, keys and session) to the cloud.
	     Predictive back (Back previews the screen before), on by default from API 36. -->
	<application android:label="kofrenot" android:icon="@mipmap/icon" android:networkSecurityConfig="@xml/network_security_config" android:allowBackup="false" android:enableOnBackInvokedCallback="true">
		<!-- A dataset's file opened with another app (OpenedFiles): read only, for the app the user picks, from cache/open/ only. -->
		<provider android:name="androidx.core.content.FileProvider" android:authorities="eu.dlabs.kofrenot.files" android:exported="false" android:grantUriPermissions="true">
			<meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/opened_files" />
		</provider>
	</application>
</manifest>
