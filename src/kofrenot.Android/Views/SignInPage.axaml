<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Kofrenot.Phone.Views.SignInPage">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="12">
      <TextBlock Classes="title" Text="Sign in" />
      <TextBlock Classes="caption" TextWrapping="Wrap"
                 Text="Your Kofre server account, as in kofrenot on Windows (Settings > Server)." />
      <TextBox x:Name="ServerBox" PlaceholderText="Server, https://…" />
      <TextBox x:Name="EmailBox" PlaceholderText="Email" />
      <TextBox x:Name="PasswordBox" PlaceholderText="Password" PasswordChar="•" TextInputOptions.ContentType="Password" />
      <TextBlock x:Name="Error" Classes="error" IsVisible="False" />
      <Button x:Name="SignInButton" Classes="accent" Content="Sign in" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center" Click="SignIn_Click" />
      <ProgressBar x:Name="Busy" IsIndeterminate="True" IsVisible="False" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
