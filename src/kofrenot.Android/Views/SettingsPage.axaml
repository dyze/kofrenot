<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:server="using:Kofrenot.Core.Server"
             xmlns:settings="using:Kofrenot.Core.Settings"
             x:Class="Kofrenot.Phone.Views.SettingsPage">
  <UserControl.Styles>
    <!-- A topic's header, named as its tab in the Settings window on Windows (SettingsCatalog). -->
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,16,0,0" />
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <!-- A line of the exchanges' statistics: the day or kind, then its numbers, on two lines to fit the phone. -->
    <DataTemplate x:Key="ExchangeLine" DataType="server:ExchangeRow">
      <StackPanel Margin="0,2">
        <TextBlock Text="{Binding Label}" />
        <TextBlock Classes="caption">
          <Run Text="{Binding Requests}" /><Run Text=" requests, " /><Run Text="{Binding Failed}" /><Run Text=" failed · ↑ " /><Run Text="{Binding Up}" /><Run Text=" ↓ " /><Run Text="{Binding Down}" />
        </TextBlock>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="bar">
      <Grid ColumnDefinitions="Auto,*">
        <Button Classes="flat" Content="‹" FontSize="24" Click="Back_Click" />
        <TextBlock Grid.Column="1" Classes="title" Text="Settings" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <ScrollViewer>
      <!-- The topics in the order of the Windows tabs; those the phone has no setting for are left out. -->
      <StackPanel Margin="16,0,16,16" Spacing="8">
        <TextBlock Classes="section" Text="{x:Static settings:SettingsCatalog.VaultTab}" />
        <TextBlock x:Name="Vault" TextWrapping="Wrap" />
        <Button x:Name="MembersButton" Content="Members…" Click="Members_Click" />
        <Button x:Name="ForgetButton" Content="Forget its remembered pass phrase" Click="Forget_Click" />

        <TextBlock Classes="section" Text="{x:Static settings:SettingsCatalog.ServerTab}" />
        <TextBlock x:Name="Account" TextWrapping="Wrap" />
        <Button Content="Sign out" Click="SignOut_Click" />

        <TextBlock Classes="section" Text="{x:Static settings:SettingsCatalog.AppearanceTab}" />
        <TextBlock Text="Theme" />
        <!-- In the order of ThemeChoice: System, Light, Dark. -->
        <ComboBox x:Name="ThemeBox" HorizontalAlignment="Stretch" SelectionChanged="Theme_Changed">
          <ComboBoxItem Content="Follow Android" />
          <ComboBoxItem Content="Light" />
          <ComboBoxItem Content="Dark" />
        </ComboBox>

        <TextBlock Classes="section" Text="{x:Static settings:SettingsCatalog.LoggingTab}" />
        <CheckBox x:Name="DebugBox" Content="Debug details in the log" IsCheckedChanged="Debug_Changed" />
        <TextBlock x:Name="LogFolder" Classes="caption" TextWrapping="Wrap" />
        <!-- This phone's exchanges with the server, per day for 30 days, then by kind (SettingsPage.Exchanges). -->
        <TextBlock Text="Exchanges with the server" Margin="0,8,0,0" />
        <TextBlock Classes="caption" Text="Per day for 30 days, on this phone only: to analyse a slow sync." TextWrapping="Wrap" />
        <ItemsControl x:Name="ExchangeDays" ItemTemplate="{StaticResource ExchangeLine}" />
        <TextBlock Classes="caption" Text="By kind" Margin="0,4,0,0" />
        <ItemsControl x:Name="ExchangeKinds" ItemTemplate="{StaticResource ExchangeLine}" />
        <Button Content="Copy" Click="CopyExchanges_Click" />

        <TextBlock Classes="section" Text="{x:Static settings:SettingsCatalog.AboutTab}" />
        <TextBlock x:Name="About" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
