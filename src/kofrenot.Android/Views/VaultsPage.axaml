<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Kofrenot.Phone.Views"
             x:Class="Kofrenot.Phone.Views.VaultsPage">
  <DockPanel>
    <views:TopBar x:Name="Bar" DockPanel.Dock="Top" Title="Vaults">
      <views:TopBar.Actions>
        <Button x:Name="SettingsButton" Classes="icon" Click="More_Click">
          <PathIcon Data="{DynamicResource icon.more}" />
        </Button>
      </views:TopBar.Actions>
    </views:TopBar>
    <StackPanel DockPanel.Dock="Bottom" Margin="{StaticResource PageMargin}" Spacing="{StaticResource Gap}">
      <TextBlock x:Name="Empty" Classes="caption" TextWrapping="Wrap" IsVisible="False" />
      <Button x:Name="AddButton" Classes="accent" Content="Add from the server" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center" Click="Add_Click" />
      <ProgressBar x:Name="Busy" IsIndeterminate="True" IsVisible="False" />
    </StackPanel>
    <Panel>
      <ScrollViewer x:Name="VaultsScroller">
        <views:VaultList x:Name="Vaults" />
      </ScrollViewer>
      <!-- Adding: the account's vaults not on the phone yet. -->
      <ListBox x:Name="Stores" IsVisible="False" SelectionChanged="Stores_SelectionChanged">
        <ListBox.DataTemplates>
          <DataTemplate DataType="views:StoreRow">
            <Grid ColumnDefinitions="Auto,*" MinHeight="56">
              <PathIcon Data="{DynamicResource icon.cloud}" Width="20" Height="20" VerticalAlignment="Center" Margin="8,0,12,0" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" Classes="body" />
                <TextBlock Classes="caption" Text="{Binding Detail}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.DataTemplates>
      </ListBox>
    </Panel>
  </DockPanel>
</UserControl>
