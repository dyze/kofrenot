<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Kofrenot.Phone.Views"
             x:Class="Kofrenot.Phone.Views.VaultsPage">
  <DockPanel>
    <views:TopBar x:Name="Bar" DockPanel.Dock="Top" Title="Vaults">
      <views:TopBar.Actions>
        <Button x:Name="SettingsButton" Classes="icon" Click="More_Click">
          <PathIcon Data="{StaticResource MoreIcon}" />
        </Button>
      </views:TopBar.Actions>
    </views:TopBar>
    <StackPanel DockPanel.Dock="Bottom" Margin="{StaticResource PageMargin}" Spacing="{StaticResource Gap}">
      <TextBlock x:Name="Empty" Classes="caption" TextWrapping="Wrap" IsVisible="False" />
      <Button x:Name="AddButton" Classes="accent" Content="Add from the server" HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center" Click="Add_Click" />
      <ProgressBar x:Name="Busy" IsIndeterminate="True" IsVisible="False" />
    </StackPanel>
    <ListBox x:Name="List" SelectionChanged="List_SelectionChanged">
      <ListBox.DataTemplates>
        <DataTemplate DataType="views:VaultRow">
          <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="56">
            <Ellipse Width="10" Height="10" Fill="{Binding Dot}" VerticalAlignment="Center" Margin="8,0" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" Classes="body" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="caption" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="2" Classes="icon" Tag="{Binding}" Click="Remove_Click">
              <PathIcon Data="{StaticResource CloseIcon}" />
            </Button>
          </Grid>
        </DataTemplate>
        <DataTemplate DataType="views:StoreRow">
          <StackPanel MinHeight="56" VerticalAlignment="Center" Margin="8,0">
            <TextBlock Text="{Binding Name}" Classes="body" />
            <TextBlock Classes="caption" Text="{Binding Detail}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.DataTemplates>
    </ListBox>
  </DockPanel>
</UserControl>
