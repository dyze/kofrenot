<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Kofrenot.Phone.Views"
             x:Class="Kofrenot.Phone.Views.ChipBox">
  <UserControl.Styles>
    <!-- A label: a node's (its glyph and colour), new (dashed, ＋), or the link type (accent). -->
    <Style Selector="Border.chip">
      <Setter Property="Padding" Value="5,1,7,1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource ChipStroke}" />
      <Setter Property="Background" Value="{StaticResource ChipFill}" />
    </Style>
    <Style Selector="Border.chip.new">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.chip.link">
      <Setter Property="Padding" Value="7,1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="Border.chip.link TextBlock">
      <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
    </Style>
    <!-- A qualifier: outlined in the accent's colour (ChipInput). -->
    <Style Selector="Border.chip.qualifier">
      <Setter Property="Padding" Value="7,1" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Rectangle.newOutline">
      <Setter Property="RadiusX" Value="4" />
      <Setter Property="RadiusY" Value="4" />
      <Setter Property="Fill" Value="{StaticResource NewFill}" />
      <Setter Property="Stroke" Value="{StaticResource NewStroke}" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="StrokeDashArray" Value="3,2" />
    </Style>
    <!-- A proposal of the list: a full-width row, the one Enter accepts in bold. -->
    <Style Selector="Button.proposal">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="Button.proposal.selected">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>
  <!-- The labels before the text, as the input box on Windows: a tap on the last one (or Backspace with no
       text) turns it back into text. The proposal after the text, and the list when there are several. -->
  <Panel x:Name="Area" ClipToBounds="True">
    <!-- Go, not Android's default Done for one line: Avalonia hides the keyboard on Done; Go sends Enter only.
         Its text scrolls with the caret (Hidden, not Disabled), so what is typed stays in sight; the labels
         scroll too, within a part of the box, their end in sight. -->
    <TextBox x:Name="Box" VerticalContentAlignment="Center" TextInputOptions.ReturnKeyType="Go"
             TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Hidden" TextChanged="Box_TextChanged">
      <TextBox.InnerLeftContent>
        <ScrollViewer x:Name="ChipsScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
          <StackPanel x:Name="Chips" Orientation="Horizontal" Spacing="{StaticResource GapS}" Margin="6,0,0,0" VerticalAlignment="Center" />
        </ScrollViewer>
      </TextBox.InnerLeftContent>
      <!-- Clears the labels and the text, while there are some. -->
      <TextBox.InnerRightContent>
        <Button x:Name="ClearButton" Classes="icon" IsVisible="False" Click="Clear_Click">
          <PathIcon Data="{DynamicResource icon.close}" Width="16" Height="16" />
        </Button>
      </TextBox.InnerRightContent>
    </TextBox>
    <!-- Placed right after the text, as on Windows: the box's own font and size. -->
    <TextBlock x:Name="ProposalText" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent"
               FontSize="{Binding #Box.FontSize}" FontFamily="{Binding #Box.FontFamily}"
               Foreground="{StaticResource Secondary}" IsVisible="False" Tapped="ProposalText_Tapped" />
    <!-- Several proposals: under the box, a tap accepts one (ChipBox.Proposals). -->
    <Popup x:Name="ProposalList" PlacementTarget="{Binding #Box}" Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="False">
      <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" BorderBrush="{StaticResource ChipStroke}"
              BorderThickness="1" CornerRadius="8" Padding="0,4">
        <StackPanel x:Name="ProposalItems" />
      </Border>
    </Popup>
  </Panel>
</UserControl>
