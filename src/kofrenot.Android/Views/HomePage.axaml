<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Kofrenot.Phone.Views"
             x:Class="Kofrenot.Phone.Views.HomePage">
  <UserControl.Styles>
    <!-- A label of the search box: a node's (its glyph and colour), new (dashed, ＋), or the link type (accent). -->
    <Style Selector="Border.chip">
      <Setter Property="Padding" Value="5,1,7,1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource ChipStroke}" />
      <Setter Property="Background" Value="{StaticResource ChipFill}" />
    </Style>
    <Style Selector="Border.chip.new">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.chip.link">
      <Setter Property="Padding" Value="7,1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="Border.chip.link TextBlock">
      <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
    </Style>
    <Style Selector="Rectangle.newOutline">
      <Setter Property="RadiusX" Value="4" />
      <Setter Property="RadiusY" Value="4" />
      <Setter Property="Fill" Value="{StaticResource NewFill}" />
      <Setter Property="Stroke" Value="{StaticResource NewStroke}" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="StrokeDashArray" Value="3,2" />
    </Style>
  </UserControl.Styles>
  <Grid>
    <DockPanel>
      <!-- ☰: the vault and its sync, in a sheet (its dot: where the sync stands); the search box; ⋮: Settings. -->
      <views:TopBar DockPanel.Dock="Top">
        <Grid ColumnDefinitions="Auto,*">
          <Button Classes="icon" Click="Vault_Click">
            <Panel>
              <PathIcon Data="{StaticResource MenuIcon}" />
              <Ellipse x:Name="SyncDot" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0" />
            </Panel>
          </Button>
          <!-- The labels (ChipInput) before the text, as the input box on Windows: a tap on the last one
               (or Backspace with no text) turns it back into text. A tap on the proposal accepts it (Tab on Windows). -->
          <Panel x:Name="SearchArea" Grid.Column="1" Margin="4,0" ClipToBounds="True">
            <!-- Go, not Android's default Done for one line: Avalonia hides the keyboard on Done; Go sends Enter only. -->
            <TextBox x:Name="SearchBox" TextInputOptions.ReturnKeyType="Go" PlaceholderText="Search or add" TextChanged="Search_TextChanged">
              <TextBox.InnerLeftContent>
                <StackPanel x:Name="Chips" Orientation="Horizontal" Spacing="{StaticResource GapS}" Margin="6,0,0,0" VerticalAlignment="Center" />
              </TextBox.InnerLeftContent>
            </TextBox>
            <!-- Placed right after the text (HomePage.Chips), as on Windows. -->
            <TextBlock x:Name="ProposalText" HorizontalAlignment="Left" VerticalAlignment="Center" Background="Transparent"
                       Foreground="{StaticResource Secondary}" IsVisible="False" Tapped="Proposal_Tapped" />
          </Panel>
        </Grid>
        <views:TopBar.Actions>
          <Button Classes="icon" Click="More_Click">
            <PathIcon Data="{StaticResource MoreIcon}" />
          </Button>
        </views:TopBar.Actions>
      </views:TopBar>
      <Border x:Name="ReadOnlyBanner" DockPanel.Dock="Top" Background="{StaticResource Banner}" Padding="16,6">
        <TextBlock x:Name="ReadOnlyText" Classes="caption" TextWrapping="Wrap" />
      </Border>
      <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel x:Name="Tabs" Orientation="Horizontal" Margin="8,4" Spacing="{StaticResource GapS}" />
      </ScrollViewer>
      <!-- What the text adds, as the input box on Windows: a tap shows the creation screen (CreationPage). -->
      <Button x:Name="AddButton" DockPanel.Dock="Top" Classes="flat" Margin="12,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
              IsVisible="False" Click="Add_Click">
        <TextBlock x:Name="AddText" TextWrapping="Wrap" Foreground="{StaticResource Accent}" />
      </Button>
      <TextBlock x:Name="Message" DockPanel.Dock="Top" Classes="caption" Margin="{StaticResource PageMargin}" TextWrapping="Wrap" IsVisible="False" />
      <!-- Its last rows clear of ＋. -->
      <ListBox x:Name="List" Padding="0,0,0,88" SelectionChanged="List_SelectionChanged">
        <ListBox.DataTemplates>
          <DataTemplate DataType="views:TreeRow">
            <Grid ColumnDefinitions="Auto,*" Margin="{Binding Indent}">
              <Button Classes="flat toggle" Content="{Binding Toggle}" IsVisible="{Binding Item.CanExpand}" Tag="{Binding}"
                      Click="Toggle_Click" Width="{StaticResource TouchTarget}" Padding="0" />
              <ContentControl Grid.Column="1" Content="{Binding Row}" Margin="{Binding Shift}" />
            </Grid>
          </DataTemplate>
        </ListBox.DataTemplates>
      </ListBox>
    </DockPanel>
    <!-- ＋: files from the phone, or a photo or video taken now, from a sheet (HomePage.AddFiles). -->
    <Button x:Name="AddFilesButton" Classes="accent fab" Click="AddFiles_Click">
      <PathIcon Data="{StaticResource AddIcon}" />
    </Button>
  </Grid>
</UserControl>
