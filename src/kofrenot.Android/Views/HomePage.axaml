<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Kofrenot.Phone.Views"
             x:Class="Kofrenot.Phone.Views.HomePage">
  <UserControl.Styles>
    <!-- A header of a query view's table: as wide as its column, its text where the column's starts. -->
    <Style Selector="Button.column">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <!-- ▦ while the list shows cards. -->
    <Style Selector="PathIcon.on">
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>
  </UserControl.Styles>
  <UserControl.Resources>
    <!-- A list view's cards in columns (HomePage.Cards). -->
    <ItemsPanelTemplate x:Key="CardsPanel">
      <views:CardColumns Margin="8,4" />
    </ItemsPanelTemplate>
    <!-- The home's rows in columns when the screen is wide (HomePage.Home). -->
    <ItemsPanelTemplate x:Key="HomePanel">
      <views:HomeColumnsPanel />
    </ItemsPanelTemplate>
  </UserControl.Resources>
  <Grid>
    <DockPanel>
      <!-- ☰: the vault and its sync, the other vaults and Settings, in a sheet (its dot: where the sync stands); the search box. -->
      <views:TopBar DockPanel.Dock="Top">
        <Grid ColumnDefinitions="Auto,*">
          <Button Classes="icon" Click="Vault_Click">
            <Panel>
              <PathIcon Data="{DynamicResource icon.menu}" />
              <Ellipse x:Name="SyncDot" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0" />
            </Panel>
          </Button>
          <!-- Typed as the input box on Windows: labels, proposals (HomePage.Chips). -->
          <views:ChipBox x:Name="SearchBox" Grid.Column="1" Margin="4,0" Placeholder="Search or add" />
        </Grid>
      </views:TopBar>
      <Border x:Name="ReadOnlyBanner" DockPanel.Dock="Top" Background="{StaticResource Banner}" Padding="16,6">
        <TextBlock x:Name="ReadOnlyText" Classes="caption" TextWrapping="Wrap" />
      </Border>
      <!-- The tabs that fit whole, ▾ always at their right: the tabs left out, then the views to open (HomePage.Tabs). -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="8,4,4,4">
        <views:TabStripPanel x:Name="Tabs" ClipToBounds="True" />
        <Button Grid.Column="1" Classes="icon" Click="AllTabs_Click">
          <PathIcon Data="{DynamicResource icon.chevron-down}" />
        </Button>
      </Grid>
      <!-- A view tab's bar: how many rows it shows, ▦ a list's cards (HomePage.Cards), ⋮ its actions (HomePage.Tabs). -->
      <Grid x:Name="ViewBar" DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="16,0,4,0" IsVisible="False">
        <TextBlock x:Name="ViewCount" Classes="caption" VerticalAlignment="Center" />
        <Button x:Name="CardsButton" Grid.Column="1" Classes="icon" Click="Cards_Click" IsVisible="False">
          <PathIcon x:Name="CardsIcon" Data="{DynamicResource icon.view-cards}" />
        </Button>
        <Button Grid.Column="2" Classes="icon" Click="ViewActions_Click">
          <PathIcon Data="{DynamicResource icon.more}" />
        </Button>
      </Grid>
      <!-- What the text adds, as the input box on Windows: a tap shows the creation screen (CreationPage). -->
      <Button x:Name="AddButton" DockPanel.Dock="Top" Classes="flat" Margin="12,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
              IsVisible="False" Click="Add_Click">
        <TextBlock x:Name="AddText" TextWrapping="Wrap" Foreground="{StaticResource Accent}" />
      </Button>
      <TextBlock x:Name="Message" DockPanel.Dock="Top" Classes="caption" Margin="{StaticResource PageMargin}" TextWrapping="Wrap" IsVisible="False" />
      <!-- Sideways only for a query view's table, its header staying over its rows (HomePage.Query). -->
      <ScrollViewer x:Name="TableScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
        <DockPanel>
          <ItemsControl x:Name="TableHeader" DockPanel.Dock="Top" IsVisible="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="views:QueryColumnHeader">
                <Button Classes="flat column" Width="{Binding Width}" Tag="{Binding}" Click="QueryHeader_Click">
                  <TextBlock Classes="caption" Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- Its last rows clear of ＋ (HomePage.ShowList). -->
          <ListBox x:Name="List" SelectionChanged="List_SelectionChanged" SizeChanged="List_SizeChanged">
            <ListBox.DataTemplates>
              <DataTemplate DataType="views:TreeRow">
                <Grid ColumnDefinitions="Auto,*" Margin="{Binding Indent}">
                  <Button Classes="flat toggle" IsVisible="{Binding Item.CanExpand}" Tag="{Binding}" Click="Toggle_Click">
                    <PathIcon Data="{Binding Toggle}" />
                  </Button>
                  <ContentControl Grid.Column="1" Content="{Binding Row}" Margin="{Binding Shift}" />
                </Grid>
              </DataTemplate>
              <DataTemplate DataType="views:QueryTableRow">
                <StackPanel Orientation="Horizontal">
                  <ContentControl Content="{Binding Row}" Width="{Binding NameWidth}" />
                  <ItemsControl ItemsSource="{Binding Cells}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="views:QueryCell">
                        <TextBlock Classes="body" Text="{Binding Text}" Width="{Binding Width}" Padding="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
              <DataTemplate DataType="views:CardRow">
                <views:CardView Card="{Binding}" />
              </DataTemplate>
            </ListBox.DataTemplates>
          </ListBox>
        </DockPanel>
      </ScrollViewer>
    </DockPanel>
    <!-- ＋: files from the phone, or a photo or video taken now, from a sheet (HomePage.AddFiles). -->
    <Button x:Name="AddFilesButton" Classes="accent fab" Click="AddFiles_Click">
      <PathIcon Data="{DynamicResource icon.add}" />
    </Button>
  </Grid>
</UserControl>
