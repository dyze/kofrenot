<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Kofrenot.Phone.Views"
             x:Class="Kofrenot.Phone.Views.NodePage">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="bar">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="flat" Content="‹" FontSize="24" Click="Back_Click" />
        <TextBlock x:Name="Trail" Grid.Column="1" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <!-- Rename, colour, pin, delete (NodePage.Actions). -->
        <Button x:Name="ActionsButton" Grid.Column="2" Classes="flat" Content="⋯" FontSize="20" />
      </Grid>
    </Border>
    <ScrollViewer>
      <StackPanel Margin="16,8,16,24" Spacing="8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Ellipse x:Name="ColorDot" Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center" />
          <SelectableTextBlock x:Name="NodeName" Grid.Column="1" Classes="title" TextWrapping="Wrap" />
          <TextBlock x:Name="Pinned" Grid.Column="2" Classes="caption" Text="Pinned" VerticalAlignment="Center" />
        </Grid>
        <TextBlock x:Name="NodeType" Classes="caption" />
        <!-- Its fields: a tap fills one (NodePage.Fields); an image is set on Windows. -->
        <ItemsControl x:Name="Fields" IsVisible="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="views:FieldLine">
              <Grid ColumnDefinitions="120,*" Margin="0,2">
                <TextBlock Classes="caption" Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="4">
                  <Button Classes="flat" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Tag="{Binding}" Click="Field_Click">
                    <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                  </Button>
                  <Image Source="{Binding Thumbnail}" MaxHeight="96" HorizontalAlignment="Left" IsVisible="{Binding HasThumbnail}" />
                  <Button Content="Open with…" Tag="{Binding}" IsVisible="{Binding HasImage}" Click="OpenImage_Click" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="OfflineButton" IsVisible="False" Click="Offline_Click" />
        <!-- A name, colour or value set on two devices: each offered to keep (NodePage.Fields). -->
        <StackPanel x:Name="Conflicts" Spacing="2" IsVisible="False" />
        <Border x:Name="NoteBox" CornerRadius="8" Padding="12" IsVisible="False">
          <StackPanel Spacing="8">
            <StackPanel x:Name="Note" Spacing="4" />
            <TextBox x:Name="NoteEditor" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" IsVisible="False"
                     PlaceholderText="Markdown: # heading, - item, - [ ] task" />
            <views:TaskListEditor x:Name="TaskEditor" IsVisible="False" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <Button x:Name="CheckboxesButton" Content="Checkboxes" IsVisible="False" Click="Checkboxes_Click" />
              <Button x:Name="EditNoteButton" Content="Edit" Click="EditNote_Click" />
              <Button x:Name="CancelNoteButton" Content="Cancel" IsVisible="False" Click="CancelNote_Click" />
              <Button x:Name="SaveNoteButton" Classes="accent" Content="Save" IsVisible="False" Click="SaveNote_Click" />
            </StackPanel>
          </StackPanel>
        </Border>
        <TextBlock x:Name="ContentText" TextWrapping="Wrap" IsVisible="False" />
        <ItemsControl x:Name="Files" IsVisible="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="views:FileRow">
              <StackPanel Spacing="4" Margin="0,4">
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                <TextBlock Classes="caption" Text="{Binding Size}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Open with…" Tag="{Binding}" Click="OpenWith_Click" />
                  <Button Content="Save as…" Tag="{Binding}" Click="SaveAs_Click" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ProgressBar x:Name="Busy" IsIndeterminate="True" IsVisible="False" />
        <Button x:Name="OpenViewButton" Content="Open as a tab" IsVisible="False" Click="OpenView_Click" />
        <TextBlock x:Name="LinksHeader" Classes="caption" Text="Links" Margin="0,12,0,0" />
        <ItemsControl x:Name="Links">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="views:NodeRow">
              <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Padding="0" Content="{Binding}" Tag="{Binding}" Click="Link_Click">
                <!-- A long press: remove the link (NodePage.Actions). -->
                <Button.ContextFlyout>
                  <MenuFlyout>
                    <MenuItem Header="Remove link…" Click="RemoveLink_Click" />
                  </MenuFlyout>
                </Button.ContextFlyout>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- Its versions, newest first; Restore makes one the current one again (NodePage.History). -->
        <Expander x:Name="HistoryBox" Header="History" Margin="0,12,0,0" HorizontalAlignment="Stretch">
          <StackPanel Spacing="4">
            <ItemsControl x:Name="History">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="views:HistoryLine">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Classes="caption" Text="{Binding Heading}" />
                      <TextBlock Text="{Binding Label}" TextWrapping="Wrap" IsVisible="{Binding HasLabel}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Restore" Tag="{Binding}" IsVisible="{Binding CanRestore}" Click="Restore_Click" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
