<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Kofrenot.Phone.Views"
             x:Class="Kofrenot.Phone.Views.NodePage">
  <UserControl.Styles>
    <!-- A link to a node open on a screen before: greyed, not opened again, as on Windows. -->
    <Style Selector="Button.openBefore">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <!-- A chip of the trail: a 48 dp target around a small chip; the current one bold, not tapped. -->
    <Style Selector="Button.trail">
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="Button.trail.current">
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- An action's icon before its name: Open, Export…, Share…, Import…, a note's Add item and n checked. -->
    <Style Selector="StackPanel.iconLabel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="6" />
    </Style>
    <!-- A file's actions: narrow enough for one row on a phone, wrapped only when they do not fit. -->
    <Style Selector="WrapPanel.actions > Button">
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="StackPanel.iconLabel > PathIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="StackPanel.iconLabel > TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource ChipStroke}" />
      <Setter Property="Background" Value="{StaticResource ChipFill}" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <views:TopBar DockPanel.Dock="Top">
      <!-- The screens up to this one, as chips: a tap goes back to it, as the breadcrumb on Windows. -->
      <ScrollViewer x:Name="TrailScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="Trail">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="views:TrailChip">
              <StackPanel Orientation="Horizontal">
                <TextBlock Classes="caption" Text="›" Margin="2,0" VerticalAlignment="Center" IsVisible="{Binding !IsFirst}" />
                <Button Classes="flat trail" Classes.current="{Binding IsCurrent}" Tag="{Binding}" Click="TrailChip_Click">
                  <Border Classes="chip">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GapS}">
                      <PathIcon Data="{DynamicResource icon.home}" Width="14" Height="14" IsVisible="{Binding IsHome}" />
                      <TextBlock Classes="caption" Text="{Binding Label}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                </Button>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <views:TopBar.Actions>
        <StackPanel Orientation="Horizontal">
          <!-- Its name searched on the web, by the phone's search app (NodePage.Actions). -->
          <Button Classes="icon" Click="WebSearch_Click">
            <PathIcon Data="{DynamicResource icon.globe}" />
          </Button>
          <!-- Keep offline, in the accent while kept (NodePage.Offline). -->
          <Button x:Name="OfflineButton" Classes="icon" IsVisible="False" Click="Offline_Click">
            <PathIcon x:Name="OfflineIcon" Data="{DynamicResource icon.offline}" />
          </Button>
          <!-- History, rename, colour, pin, fields, types, delete: a sheet (NodePage.Actions). -->
          <Button x:Name="ActionsButton" Classes="icon" Click="Actions_Click">
            <PathIcon Data="{DynamicResource icon.more}" />
          </Button>
        </StackPanel>
      </views:TopBar.Actions>
    </views:TopBar>
    <ScrollViewer>
      <StackPanel Margin="{StaticResource PageMargin}" Spacing="{StaticResource Gap}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Ellipse x:Name="ColorDot" Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center" />
          <!-- A tap renames it, as a click on the name does on Windows (NodePage.Actions). -->
          <TextBlock x:Name="NodeName" Grid.Column="1" Classes="title" TextWrapping="Wrap" Background="Transparent" Tapped="NodeName_Tapped" />
          <TextBlock x:Name="Pinned" Grid.Column="2" Classes="caption" Text="Pinned" VerticalAlignment="Center" />
        </Grid>
        <TextBlock x:Name="NodeType" Classes="caption" />
        <!-- Its fields: a tap fills one (NodePage.Fields); an image is set on Windows. -->
        <ItemsControl x:Name="Fields" IsVisible="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="views:FieldLine">
              <!-- Its label on the line of its value; its action an icon on the right, as on Windows. -->
              <Grid ColumnDefinitions="120,*,Auto">
                <Border MinHeight="{StaticResource FieldRowHeight}" VerticalAlignment="Top">
                  <TextBlock Classes="caption" Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="{StaticResource GapS}">
                  <Button Classes="flat" Padding="0" MinHeight="{StaticResource FieldRowHeight}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                          Tag="{Binding}" Click="Field_Click">
                    <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                  </Button>
                  <Image Source="{Binding Thumbnail}" MaxHeight="96" HorizontalAlignment="Left" IsVisible="{Binding HasThumbnail}" Tag="{Binding}" Tapped="FieldImage_Tapped" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                  <!-- A web address opened, a mail written, an address shown on a map (NodePage.Fields). -->
                  <Button Classes="icon" Height="{StaticResource FieldRowHeight}" Tag="{Binding}" IsVisible="{Binding HasLink}" Click="OpenLink_Click">
                    <PathIcon Data="{Binding LinkIcon}" />
                  </Button>
                  <Button Classes="icon" Height="{StaticResource FieldRowHeight}" Tag="{Binding}" IsVisible="{Binding HasImage}" Click="OpenImage_Click">
                    <PathIcon Data="{DynamicResource icon.open}" />
                  </Button>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- A name, colour or value set on two devices: each offered to keep (NodePage.Fields). -->
        <StackPanel x:Name="Conflicts" Spacing="{StaticResource GapS}" IsVisible="False" />
        <!-- A note, always editable as on Windows: its Markdown, or its items when its lines are all
             tasks; saved by the save icon and when it is left (NodePage.Note). -->
        <Border x:Name="NoteBox" CornerRadius="8" Padding="12" IsVisible="False">
          <StackPanel Spacing="{StaticResource Gap}">
            <!-- Edited on two devices before they synced: a version kept, or merged below and saved. -->
            <StackPanel x:Name="NoteConflict" Spacing="{StaticResource GapS}" IsVisible="False">
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="Edited on two devices before they synced. Keep a version, or merge them below and save:" />
              <WrapPanel x:Name="ConflictVersions" ItemSpacing="{StaticResource GapS}" LineSpacing="{StaticResource GapS}" />
            </StackPanel>
            <TextBox x:Name="NoteEditor" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" TextChanged="NoteEditor_TextChanged"
                     PlaceholderText="Markdown: **bold**, *italic*, # heading, - list, [link](url)" />
            <views:TaskListEditor x:Name="TaskEditor" IsVisible="False" />
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBlock x:Name="NoteStatus" Classes="caption" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button x:Name="CheckboxesButton" Grid.Column="1" Classes="flat" Content="Checkboxes" Click="Checkboxes_Click" />
              <Button x:Name="SaveNoteButton" Grid.Column="2" Classes="icon" Click="SaveNote_Click">
                <PathIcon Data="{DynamicResource icon.save}" />
              </Button>
            </Grid>
          </StackPanel>
        </Border>
        <TextBlock x:Name="ContentText" TextWrapping="Wrap" IsVisible="False" />
        <!-- An image dataset's thumbnail, as its header on Windows (NodePage.ShowThumbnail). -->
        <Border x:Name="ThumbnailFrame" CornerRadius="8" ClipToBounds="True" HorizontalAlignment="Left" IsVisible="False">
          <Image x:Name="Thumbnail" MaxHeight="240" Stretch="Uniform" Tapped="Thumbnail_Tapped" />
        </Border>
        <ItemsControl x:Name="Files" IsVisible="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="views:FileRow">
              <StackPanel Spacing="{StaticResource GapS}" Margin="0,4">
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                <TextBlock Classes="caption" Text="{Binding Size}" />
                <!-- Named as on Windows: Open, Export…, Import…; Share… the phone's own. One row when they fit. -->
                <WrapPanel Classes="actions" ItemSpacing="{StaticResource GapS}" LineSpacing="{StaticResource GapS}">
                  <Button Tag="{Binding}" Click="Open_Click">
                    <StackPanel Classes="iconLabel">
                      <PathIcon Data="{DynamicResource icon.open}" />
                      <TextBlock Text="Open" />
                    </StackPanel>
                  </Button>
                  <Button Tag="{Binding}" Click="Export_Click">
                    <StackPanel Classes="iconLabel">
                      <PathIcon Data="{DynamicResource icon.export}" />
                      <TextBlock Text="Export…" />
                    </StackPanel>
                  </Button>
                  <Button Tag="{Binding}" Click="Share_Click">
                    <StackPanel Classes="iconLabel">
                      <PathIcon Data="{DynamicResource icon.share}" />
                      <TextBlock Text="Share…" />
                    </StackPanel>
                  </Button>
                  <Button IsVisible="{Binding CanImport}" Click="Import_Click">
                    <StackPanel Classes="iconLabel">
                      <PathIcon Data="{DynamicResource icon.import}" />
                      <TextBlock Text="Import…" />
                    </StackPanel>
                  </Button>
                </WrapPanel>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!-- A new version of its file, as Import… on Windows (NodePage.Dataset). -->
        <Button x:Name="ImportButton" IsVisible="False" Click="Import_Click">
          <StackPanel Classes="iconLabel">
            <PathIcon Data="{DynamicResource icon.import}" />
            <TextBlock Text="Import…" />
          </StackPanel>
        </Button>
        <ProgressBar x:Name="Busy" IsIndeterminate="True" IsVisible="False" />
        <Button x:Name="OpenViewButton" IsVisible="False" Click="OpenView_Click">
          <StackPanel Classes="iconLabel">
            <PathIcon Data="{DynamicResource icon.view}" />
            <TextBlock Text="Open as a tab" />
          </StackPanel>
        </Button>
        <!-- Links, and + Link: a box typed after the node's name, as the Link box on Windows (NodePage.Link). -->
        <Grid x:Name="LinksHeader" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
          <TextBlock Classes="caption" Text="Links" VerticalAlignment="Center" />
          <Button x:Name="AddLinkButton" Grid.Column="1" Classes="flat" Click="AddLink_Click">
            <StackPanel Classes="iconLabel">
              <PathIcon Data="{DynamicResource icon.add}" />
              <TextBlock Text="Link" />
            </StackPanel>
          </Button>
        </Grid>
        <StackPanel x:Name="LinkPanel" Spacing="{StaticResource GapS}" IsVisible="False">
          <Grid ColumnDefinitions="*,Auto">
            <views:ChipBox x:Name="LinkBox" Placeholder="relates to Frank Herbert" />
            <Button Grid.Column="1" Classes="icon" Click="CloseLink_Click">
              <PathIcon Data="{DynamicResource icon.close}" />
            </Button>
          </Grid>
          <TextBlock x:Name="LinkPreview" Classes="caption" TextWrapping="Wrap" />
        </StackPanel>
        <ItemsControl x:Name="Links">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="views:NodeRow">
              <!-- A long press: remove the link, from a sheet (NodePage.Actions). -->
              <Button Classes="flat" Classes.openBefore="{Binding !CanOpen}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      Padding="0" Content="{Binding}" Tag="{Binding}" Click="Link_Click" ContextRequested="Link_ContextRequested" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
