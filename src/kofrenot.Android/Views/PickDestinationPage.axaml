<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Kofrenot.Phone.Views"
             x:Class="Kofrenot.Phone.Views.PickDestinationPage">
  <!-- Where to put nodes: a tree view, then down its tree, a node at a time; the button takes the node reached. -->
  <DockPanel>
    <views:TopBar x:Name="Bar" DockPanel.Dock="Top" />
    <Button x:Name="HereButton" DockPanel.Dock="Bottom" Classes="accent" Margin="{StaticResource PageMargin}"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="False" Click="Here_Click" />
    <TextBlock x:Name="PathText" DockPanel.Dock="Top" Classes="caption" Margin="{StaticResource PageMargin}" TextTrimming="CharacterEllipsis" />
    <TextBlock x:Name="Message" DockPanel.Dock="Top" Classes="caption" Margin="{StaticResource PageMargin}" TextWrapping="Wrap" IsVisible="False" />
    <ListBox x:Name="List" SelectionChanged="List_SelectionChanged" />
  </DockPanel>
</UserControl>
