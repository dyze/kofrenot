<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Kofrenot.Phone.Views"
             xmlns:graph="using:Kofrenot.Core.Graph"
             x:Class="Kofrenot.Phone.Views.MembersPage">
  <!-- The open vault's members and their roles (Settings > Members). Its owner shares it and changes a role;
       a member removed is on Windows, as it rotates the vault's key. A member leaves a vault shared with them. -->
  <DockPanel>
    <views:TopBar DockPanel.Dock="Top" Title="Members" />
    <ScrollViewer>
      <StackPanel Margin="16" Spacing="8">
        <TextBlock x:Name="Intro" Classes="caption" TextWrapping="Wrap" />
        <ItemsControl x:Name="MembersList">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="graph:VaultMember">
              <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0"
                      Tag="{Binding}" Click="Member_Click">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Email}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Role}" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel x:Name="SharePanel" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
          <Button Classes="accent" Content="Share…" Click="Share_Click" />
          <ComboBox x:Name="RoleBox" SelectedIndex="0">
            <ComboBoxItem Content="as a writer" />
            <ComboBoxItem Content="as a reader" />
          </ComboBox>
        </StackPanel>
        <Button x:Name="LeaveButton" Content="Leave this vault" Click="Leave_Click" />
        <ProgressBar x:Name="Busy" IsIndeterminate="True" IsVisible="False" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
