<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Kofrenot.Phone.Views"
             x:Class="Kofrenot.Phone.Views.ImagePage">
  <!-- An image on the whole screen: pinched or double tapped to zoom, moved with a finger; ⋮ opens or shares it. -->
  <DockPanel>
    <views:TopBar x:Name="Bar" DockPanel.Dock="Top">
      <views:TopBar.Actions>
        <Button Classes="icon" Click="Actions_Click">
          <PathIcon Data="{DynamicResource icon.more}" />
        </Button>
      </views:TopBar.Actions>
    </views:TopBar>
    <ProgressBar x:Name="Busy" DockPanel.Dock="Top" IsIndeterminate="True" />
    <Panel>
      <TextBlock x:Name="Message" Classes="caption" Margin="{StaticResource PageMargin}" TextWrapping="Wrap" IsVisible="False" />
      <views:ZoomImage x:Name="Picture" />
    </Panel>
  </DockPanel>
</UserControl>
