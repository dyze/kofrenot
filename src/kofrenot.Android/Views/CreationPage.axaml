<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Kofrenot.Phone.Views"
             x:Class="Kofrenot.Phone.Views.CreationPage">
  <!-- What the search box's text adds, before it is: the link's type, then each new node's type and a
       new note's text (CreationForm, as the creation screen on Windows). Add adds it; back cancels. -->
  <DockPanel>
    <views:TopBar x:Name="Bar" DockPanel.Dock="Top" />
    <StackPanel DockPanel.Dock="Bottom" Margin="{StaticResource PageMargin}" Spacing="{StaticResource Gap}">
      <TextBlock x:Name="Status" TextWrapping="Wrap" />
      <TextBlock x:Name="Warning" Classes="error" IsVisible="False" />
      <Button x:Name="AddButton" Classes="accent" Content="Add" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="Add_Click" />
    </StackPanel>
    <ScrollViewer>
      <StackPanel x:Name="Sides" Margin="{StaticResource PageMargin}" Spacing="{StaticResource GapM}" />
    </ScrollViewer>
  </DockPanel>
</UserControl>
