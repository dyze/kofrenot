<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Kofrenot.Phone.Views.Shell">
  <!-- Its padding keeps the screens clear of the system bars and the keyboard (Shell.Insets). -->
  <Grid>
    <!-- A screen slides in from the right going forward, from the left going back. -->
    <TransitioningContentControl x:Name="PageHost">
      <TransitioningContentControl.PageTransition>
        <PageSlide Duration="0:0:0.25" Orientation="Horizontal" />
      </TransitioningContentControl.PageTransition>
    </TransitioningContentControl>
    <!-- A bottom sheet of choices (Shell.Sheet): a tap outside it, or Back, closes it. -->
    <Border x:Name="SheetScrim" IsVisible="False" Background="{StaticResource Scrim}" PointerPressed="SheetScrim_PointerPressed">
      <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="16,16,0,0" VerticalAlignment="Bottom"
              Padding="0,8,0,8">
        <DockPanel>
          <Border DockPanel.Dock="Top" Width="32" Height="4" CornerRadius="2" Background="{StaticResource Secondary}" Margin="0,4,0,8" />
          <TextBlock x:Name="SheetTitle" DockPanel.Dock="Top" Classes="caption" Margin="24,4,24,8" TextTrimming="CharacterEllipsis" />
          <ScrollViewer MaxHeight="480">
            <StackPanel x:Name="SheetChoices" />
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>
    <Border x:Name="Overlay" IsVisible="False" Background="{StaticResource Scrim}">
      <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}" CornerRadius="12" Padding="20"
              Margin="{StaticResource FormMargin}" VerticalAlignment="Center">
        <StackPanel Spacing="{StaticResource GapL}">
          <TextBlock x:Name="OverlayText" TextWrapping="Wrap" />
          <!-- A text asked (a name): what is wrong with it under it, OK only once it is fine. -->
          <TextBox x:Name="OverlayBox" IsVisible="False" TextChanged="OverlayBox_TextChanged" />
          <TextBlock x:Name="OverlayRemark" Classes="caption" TextWrapping="Wrap" IsVisible="False" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource Gap}">
            <Button x:Name="OverlayNo" Content="Cancel" Classes="flat" Click="OverlayNo_Click" />
            <Button x:Name="OverlayYes" Content="OK" Classes="accent" Click="OverlayYes_Click" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
