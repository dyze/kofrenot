<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Kofrenot.Phone.Views"
             x:Class="Kofrenot.Phone.App"
             RequestedThemeVariant="Default">
  <!-- Default: light or dark, as the phone. -->

  <!-- The tokens: the touch sizes, spacing, type sizes and colours of the screens. -->
  <Application.Resources>
    <!-- Sizes, in dp: 48 is Android's smallest touch target. -->
    <x:Double x:Key="TouchTarget">48</x:Double>
    <x:Double x:Key="BarHeight">64</x:Double>
    <!-- Spacing, on a 4 dp grid: between the items of a panel, around a screen's content, around a form. -->
    <x:Double x:Key="GapS">4</x:Double>
    <x:Double x:Key="Gap">8</x:Double>
    <x:Double x:Key="GapM">12</x:Double>
    <x:Double x:Key="GapL">16</x:Double>
    <Thickness x:Key="PageMargin">16,8,16,16</Thickness>
    <Thickness x:Key="FormMargin">24</Thickness>
    <!-- Type: title, section, body, caption. -->
    <x:Double x:Key="TitleSize">22</x:Double>
    <x:Double x:Key="SectionSize">18</x:Double>
    <x:Double x:Key="BodySize">16</x:Double>
    <x:Double x:Key="CaptionSize">13</x:Double>
    <!-- Colours. -->
    <SolidColorBrush x:Key="Accent" Color="#11968A" />
    <SolidColorBrush x:Key="OnAccent" Color="White" />
    <SolidColorBrush x:Key="Secondary" Color="#888888" />
    <SolidColorBrush x:Key="Banner" Color="#3311968A" />
    <SolidColorBrush x:Key="Scrim" Color="#99000000" />
    <SolidColorBrush x:Key="Error" Color="#D9534F" />
    <SolidColorBrush x:Key="ChipFill" Color="#22888888" />
    <SolidColorBrush x:Key="ChipStroke" Color="#55888888" />
    <SolidColorBrush x:Key="NewFill" Color="#226FBF4A" />
    <SolidColorBrush x:Key="NewStroke" Color="#6FBF4A" />
    <SolidColorBrush x:Key="Synced" Color="MediumSeaGreen" />
    <SolidColorBrush x:Key="Problem" Color="IndianRed" />
    <SolidColorBrush x:Key="Idle" Color="Gray" />
    <!-- Icons, on a 24 dp grid: ←, ⋮, ＋, ☰, ✕. -->
    <StreamGeometry x:Key="BackIcon">M20,11 H7.8 L13.4,5.4 L12,4 L4,12 L12,20 L13.4,18.6 L7.8,13 H20 Z</StreamGeometry>
    <StreamGeometry x:Key="MoreIcon">M10,6 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 Z M10,12 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 Z M10,18 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 Z</StreamGeometry>
    <StreamGeometry x:Key="AddIcon">M11,5 H13 V11 H19 V13 H13 V19 H11 V13 H5 V11 H11 Z</StreamGeometry>
    <StreamGeometry x:Key="MenuIcon">M3,6 H21 V8 H3 Z M3,11 H21 V13 H3 Z M3,16 H21 V18 H3 Z</StreamGeometry>
    <StreamGeometry x:Key="CloseIcon">M6.4,5 L12,10.6 L17.6,5 L19,6.4 L13.4,12 L19,17.6 L17.6,19 L12,13.4 L6.4,19 L5,17.6 L10.6,12 L5,6.4 Z</StreamGeometry>
    <!-- The top bar of every screen (TopBar). -->
    <ControlTheme x:Key="{x:Type views:TopBar}" TargetType="views:TopBar">
      <Setter Property="Template">
        <ControlTemplate>
          <Border MinHeight="{StaticResource BarHeight}" Padding="4,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Button x:Name="PART_Back" Classes="icon" IsVisible="{TemplateBinding ShowsBack}">
                <PathIcon Data="{StaticResource BackIcon}" />
              </Button>
              <TextBlock Grid.Column="1" Classes="title" Text="{TemplateBinding Title}" Margin="12,0"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalAlignment="Center" />
              <ContentPresenter Grid.Column="2" Content="{TemplateBinding Actions}" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Application.Resources>

  <Application.DataTemplates>
    <DataTemplate DataType="views:HeaderRow">
      <TextBlock Classes="caption" Text="{Binding Text}" Margin="16,10,16,2" />
    </DataTemplate>
    <DataTemplate DataType="views:NodeRow">
      <Grid ColumnDefinitions="Auto,*" Margin="{Binding Indent}" MinHeight="{StaticResource TouchTarget}">
        <Grid Width="24" Height="24" VerticalAlignment="Center">
          <TextBlock Text="{Binding Glyph}" FontSize="{StaticResource BodySize}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Ellipse Width="8" Height="8" Fill="{Binding Color}" IsVisible="{Binding HasColor}"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>
        <StackPanel Grid.Column="1" Margin="10,2,0,2" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontSize="{StaticResource BodySize}" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="caption" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#11968A" />
        <ColorPaletteResources x:Key="Dark" Accent="#2BB59A" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <Style Selector=":is(TextBlock).title">
      <Setter Property="FontSize" Value="{StaticResource TitleSize}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector=":is(TextBlock).section">
      <Setter Property="FontSize" Value="{StaticResource SectionSize}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector=":is(TextBlock).body">
      <Setter Property="FontSize" Value="{StaticResource BodySize}" />
    </Style>
    <Style Selector=":is(TextBlock).caption">
      <Setter Property="FontSize" Value="{StaticResource CaptionSize}" />
      <Setter Property="Foreground" Value="{StaticResource Secondary}" />
    </Style>
    <Style Selector=":is(TextBlock).error">
      <Setter Property="Foreground" Value="{StaticResource Error}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Every button is a touch target. -->
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="{StaticResource TouchTarget}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="MinWidth" Value="{StaticResource TouchTarget}" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <!-- The rows set their own height: no padding of the theme's around them. -->
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Button.toggle">
      <Setter Property="FontSize" Value="{StaticResource SectionSize}" />
    </Style>
    <!-- An icon alone (←, ⋮, ✕): a 48 dp square. -->
    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="{StaticResource TouchTarget}" />
      <Setter Property="Height" Value="{StaticResource TouchTarget}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="24" />
    </Style>
    <!-- The floating ＋ of Home, at its bottom right. -->
    <Style Selector="Button.fab">
      <Setter Property="Width" Value="56" />
      <Setter Property="Height" Value="56" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="16" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <!-- A choice of a bottom sheet (Shell.Sheet): a full-width row. -->
    <Style Selector="Button.choice">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="24,0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="FontSize" Value="{StaticResource BodySize}" />
    </Style>
  </Application.Styles>
</Application>
