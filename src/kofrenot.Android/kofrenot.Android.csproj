<Project Sdk="Microsoft.NET.Sdk">

  <!-- kofrenot for Android: reads server vaults (docs/ANDROID-CONCEPT.md). Not in kofrenot.sln, so
       build\windows.cmd needs no Android workload: built by build\android.cmd. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <!-- Android 8.0. -->
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <RootNamespace>Kofrenot.Phone</RootNamespace>
    <ApplicationId>eu.dlabs.kofrenot</ApplicationId>
    <ApplicationTitle>kofrenot</ApplicationTitle>
    <!-- From <Version> (Directory.Build.props): Android's version code must grow, 0.9 is 9, 1.0 is 1000. -->
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Multiply($([System.Version]::Parse('$(Version)').Major), 1000)), $([System.Version]::Parse('$(Version)').Minor)))</ApplicationVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The screens are made in code with their shell, never loaded by their URI. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <!-- Android's implicit usings clash with Avalonia's (Application, Button): the Android files name theirs. -->
  <ItemGroup>
    <Using Remove="Android.App" />
    <Using Remove="Android.Widget" />
  </ItemGroup>

  <ItemGroup>
    <AndroidResource Include="Resources\**\*" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- The log as on Windows: the same files, the same rules (CLAUDE.md, Logging rules). -->
  <ItemGroup>
    <Compile Include="..\kofrenot.App\Logging\LogHub.cs" Link="Logging\LogHub.cs" />
    <Compile Include="..\kofrenot.App\Logging\SerilogFileLog.cs" Link="Logging\SerilogFileLog.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\kofrenot.Core\kofrenot.Core.csproj" />
  </ItemGroup>

</Project>
