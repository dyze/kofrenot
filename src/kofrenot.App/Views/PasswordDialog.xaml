<Window x:Class="Kofrenot.UI.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kofrenot.UI.Views"
        Title="kofrenot"
        Icon="/Assets/kofrenot.ico"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SourceInitialized="Window_SourceInitialized">
  <!-- Asks the server account's current password, and a new one twice. Enter: OK, Esc: Cancel. -->
  <Window.Resources>
    <ResourceDictionary Source="SharedStyles.xaml" />
  </Window.Resources>

  <StackPanel Margin="20,18,20,16">
    <TextBlock Style="{StaticResource HeadingText}" Text="Change password" />
    <TextBlock x:Name="PlaceText" Margin="0,4,0,0" Opacity="0.7" TextTrimming="CharacterEllipsis" />
    <TextBlock Margin="0,10,0,0"
               TextWrapping="Wrap"
               Text="The password signs in to the server. Your other devices are signed out: sign in there with the new one. The pass phrase of your vaults stays the same." />

    <TextBlock Margin="0,14,0,4" Text="Current password" />
    <local:SecretBox x:Name="CurrentBox" />

    <TextBlock Margin="0,10,0,4" Text="New password" />
    <local:SecretBox x:Name="NewBox" ToolTip="At least 10 characters" />

    <TextBlock Margin="0,10,0,4" Text="New password again" />
    <local:SecretBox x:Name="AgainBox" />

    <TextBlock x:Name="ErrorText"
               Margin="0,10,0,0"
               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
               TextWrapping="Wrap"
               Visibility="Collapsed" />

    <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button MinWidth="90" Padding="12,4" Content="Change" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" Click="OkButton_Click" />
      <Button MinWidth="90" Margin="8,0,0,0" Padding="12,4" Content="Cancel" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
