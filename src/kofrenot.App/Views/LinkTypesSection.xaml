<UserControl x:Class="Kofrenot.UI.Views.LinkTypesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kofrenot.UI.Views">
  <!-- Settings > Link types: one list of the link types, built-in then the user's, a line per way
       each reads, with its phrases. "Add alias" opens a box under a line, × removes one; the user's link
       types are renamed in place (✎) or removed (×). A new link type is typed above the list, which
       scrolls on its own; Copy from… lists another vault's, to copy them here. Stored in the vault. -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SharedStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <BooleanToVisibilityConverter x:Key="VisibleWhen" />

      <!-- A small icon button at the end of a line: + (add an alias), ✎ (rename), × (remove). -->
      <Style x:Key="LineButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>

      <Style x:Key="EditorStatus" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>

      <DataTemplate DataType="{x:Type local:WayLine}">
        <Grid x:Name="Line" Margin="0,3">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" SharedSizeGroup="Way" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="WayName" Margin="0,0,16,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}" />
          <WrapPanel Grid.Column="1">
            <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Opacity="0.7" Text="{Binding BuiltIn}" />
            <TextBlock Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       Opacity="0.7"
                       Text="(both ways)"
                       Visibility="{Binding IsBothWays, Converter={StaticResource VisibleWhen}}" />
            <ItemsControl ItemsSource="{Binding Phrases.Aliases}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border x:Name="Chip"
                          Margin="0,0,6,0"
                          Padding="8,1,2,1"
                          CornerRadius="4"
                          BorderThickness="1"
                          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                          ToolTip="Your alias">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="Phrase" VerticalAlignment="Center" Text="{Binding Phrase}" />
                      <Button Style="{StaticResource LineButton}"
                              Padding="4,0"
                              ToolTip="Remove this alias"
                              Click="RemoveAlias_Click">
                        <local:IconView Size="{StaticResource RowIconSize}" Kind="remove" />
                      </Button>
                    </StackPanel>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsUsed}" Value="False">
                      <Setter TargetName="Phrase" Property="TextDecorations" Value="Strikethrough" />
                      <Setter TargetName="Chip" Property="Opacity" Value="0.6" />
                      <Setter TargetName="Chip" Property="ToolTip" Value="Not used: another link type has this phrase already (added on another device)" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Style="{StaticResource LineButton}"
                    FontFamily="{x:Static SystemFonts.MessageFontFamily}"
                    FontSize="{StaticResource CaptionFontSize}"
                    Content="Add alias"
                    ToolTip="Another phrase for this way"
                    Click="AddAlias_Click" />
            <StackPanel x:Name="YoursPanel" Orientation="Horizontal" Visibility="Collapsed">
              <Border Margin="8,0,2,0"
                      Padding="6,0"
                      VerticalAlignment="Center"
                      CornerRadius="4"
                      Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <TextBlock Text="yours" FontSize="{StaticResource CaptionFontSize}" Opacity="0.8" />
              </Border>
              <Button Style="{StaticResource LineButton}" ToolTip="Rename this link type" Click="RenameType_Click">
                <local:IconView Size="{StaticResource RowIconSize}" Kind="edit" />
              </Button>
              <Button Style="{StaticResource LineButton}" ToolTip="Remove this link type" Click="RemoveType_Click">
                <local:IconView Size="{StaticResource RowIconSize}" Kind="remove" />
              </Button>
            </StackPanel>
            <Button x:Name="QualifiersButton"
                    Style="{StaticResource LineButton}"
                    FontFamily="{x:Static SystemFonts.MessageFontFamily}"
                    FontSize="{StaticResource CaptionFontSize}"
                    Content="Qualifiers"
                    ToolTip="The fields of its links: a date, a source, a place"
                    Visibility="{Binding HasQualifiers, Converter={StaticResource VisibleWhen}}"
                    Click="EditQualifiers_Click" />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.7" Text="{Binding QualifierNames}" />
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" Text="{Binding Warning}" />
          </WrapPanel>
        </Grid>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding IsOtherWay}" Value="True">
            <Setter TargetName="WayName" Property="Margin" Value="16,0,16,0" />
            <Setter TargetName="WayName" Property="FontWeight" Value="Normal" />
          </DataTrigger>
          <DataTrigger Binding="{Binding IsYours}" Value="True">
            <Setter TargetName="YoursPanel" Property="Visibility" Value="Visible" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <!-- A new alias, under the line of its way. -->
      <DataTemplate DataType="{x:Type local:AliasEditor}">
        <StackPanel x:Name="Editor" Margin="16,3,0,6">
          <StackPanel Orientation="Horizontal">
            <TextBox Width="180"
                     VerticalContentAlignment="Center"
                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Another phrase for this way, as typed in the input box"
                     Loaded="EditorBox_Loaded"
                     KeyDown="EditorBox_KeyDown" />
            <Button x:Name="ApplyButton" Margin="8,0,0,0" Padding="12,4" Content="Add" IsEnabled="{Binding CanApply}" Click="ApplyEditor_Click" />
            <Button Margin="4,0,0,0" Padding="12,4" Content="Cancel" Click="CancelEditor_Click" />
          </StackPanel>
          <TextBlock Style="{StaticResource EditorStatus}" Text="{Binding Status}" />
        </StackPanel>
        <DataTemplate.Triggers>
          <Trigger SourceName="Editor" Property="IsKeyboardFocusWithin" Value="True">
            <Setter TargetName="ApplyButton" Property="Style" Value="{DynamicResource AccentButtonStyle}" />
          </Trigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <!-- The qualifiers of a link type, under its first line: a list of fields, as a node type's. -->
      <DataTemplate DataType="{x:Type local:QualifiersEditor}">
        <StackPanel x:Name="Editor" Margin="16,3,0,6">
          <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="{Binding Title}" />
          <ItemsControl ItemsSource="{Binding Fields}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:FieldRow}">
                <StackPanel Margin="0,2" Orientation="Horizontal">
                  <TextBox Width="160" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="Its name: Date, Source" Loaded="EditorBox_Loaded" KeyDown="EditorBox_KeyDown" />
                  <ComboBox Width="110" Margin="6,0,0,0" ItemsSource="{x:Static local:FieldRow.Kinds}" SelectedItem="{Binding Kind}" />
                  <TextBox Width="200"
                           Margin="6,0,0,0"
                           Text="{Binding Choices, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="Its options, separated by commas: Novel, Short story"
                           Visibility="{Binding IsChoice, Converter={StaticResource VisibleWhen}}"
                           KeyDown="EditorBox_KeyDown" />
                  <Button Style="{StaticResource LineButton}" ToolTip="Take this qualifier out" Click="RemoveQualifier_Click">
                    <local:IconView Size="{StaticResource RowIconSize}" Kind="remove" />
                  </Button>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
            <Button Padding="10,2" Content="Add qualifier" Click="AddQualifier_Click" />
            <Button x:Name="ApplyButton" Margin="8,0,0,0" Padding="12,4" Content="Save" IsEnabled="{Binding CanApply}" Click="ApplyEditor_Click" />
            <Button Margin="4,0,0,0" Padding="12,4" Content="Cancel" Click="CancelEditor_Click" />
          </StackPanel>
          <TextBlock Style="{StaticResource EditorStatus}" Text="{Binding Status}" />
        </StackPanel>
        <DataTemplate.Triggers>
          <Trigger SourceName="Editor" Property="IsKeyboardFocusWithin" Value="True">
            <Setter TargetName="ApplyButton" Property="Style" Value="{DynamicResource AccentButtonStyle}" />
          </Trigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <!-- A link type of the user's: renamed in place of its lines, or added above the list. -->
      <DataTemplate DataType="{x:Type local:TypeEditor}">
        <StackPanel x:Name="Editor" Margin="0,3,0,6">
          <StackPanel Orientation="Horizontal">
            <TextBox Width="140"
                     VerticalContentAlignment="Center"
                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Its name, as typed in the input box: wrote"
                     Loaded="EditorBox_Loaded"
                     KeyDown="EditorBox_KeyDown" />
            <TextBlock Margin="8,0" VerticalAlignment="Center" Text="other way" />
            <TextBox Width="140"
                     VerticalContentAlignment="Center"
                     Text="{Binding Reverse, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CanTypeReverse}"
                     ToolTip="How it reads from the other node: written by. Empty when it reads the same both ways"
                     KeyDown="EditorBox_KeyDown" />
            <Button x:Name="ApplyButton" Margin="8,0,0,0" Padding="12,4" Content="{Binding ApplyText}" IsEnabled="{Binding CanApply}" Click="ApplyEditor_Click" />
            <Button Margin="4,0,0,0"
                    Padding="12,4"
                    Content="Cancel"
                    Visibility="{Binding IsRename, Converter={StaticResource VisibleWhen}}"
                    Click="CancelEditor_Click" />
          </StackPanel>
          <TextBlock Style="{StaticResource EditorStatus}" Text="{Binding Status}" />
        </StackPanel>
        <!-- Enter applies the editor being typed in: its button is accented then, as a dialog's default one. -->
        <DataTemplate.Triggers>
          <Trigger SourceName="Editor" Property="IsKeyboardFocusWithin" Value="True">
            <Setter TargetName="ApplyButton" Property="Style" Value="{DynamicResource AccentButtonStyle}" />
          </Trigger>
        </DataTemplate.Triggers>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <StackPanel>
    <TextBlock x:Name="StateText" Margin="0,10,0,0" Opacity="0.7" TextWrapping="Wrap" />

    <StackPanel x:Name="ListPanel">
      <DockPanel Margin="0,10,12,4">
        <Button x:Name="CopyFromButton"
                DockPanel.Dock="Right"
                Padding="12,4"
                Content="Copy from…"
                ToolTip="Copy link types and aliases from another of your vaults"
                Click="CopyFrom_Click" />
        <TextBlock VerticalAlignment="Bottom" FontWeight="SemiBold" Text="New link type" />
      </DockPanel>
      <ContentControl x:Name="NewTypeLine" Focusable="False" />

      <!-- The list scrolls on its own (ListFit), so the new link type above stays in view. -->
      <ScrollViewer Margin="0,14,0,0"
                    local:ListFit.Fills="True"
                    Focusable="False"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="LineList" Margin="0,0,12,0" Grid.IsSharedSizeScope="True" />
      </ScrollViewer>
    </StackPanel>

    <!-- Another vault's link types, each ticked to copy it here with its aliases, with what copying does; in place of the list. -->
    <StackPanel x:Name="CopyPanel" Margin="0,10,12,0" Visibility="Collapsed">
      <TextBlock x:Name="CopyTitle" FontWeight="SemiBold" />
      <TextBlock Margin="0,4,0,0"
                 Opacity="0.7"
                 TextWrapping="Wrap"
                 Text="Link types are copied with their qualifiers and aliases, not their links. Copied again later, a link type is updated." />
      <ScrollViewer Margin="0,8,0,0" local:ListFit.Fills="True" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="CopyList" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type local:LinkCopyLine}">
              <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox MinWidth="0" VerticalAlignment="Center" IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanCopy}" />
                <TextBlock Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" Text="{Binding Copy.Status}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
        <Button Padding="16,4" Content="Copy" Style="{DynamicResource AccentButtonStyle}" Click="Copy_Click" />
        <Button Margin="6,0,0,0" Padding="16,4" Content="Cancel" Click="CancelCopy_Click" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
