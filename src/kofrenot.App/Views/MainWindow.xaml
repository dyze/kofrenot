<Window x:Class="Kofrenot.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="kofrenot"
        Icon="/Assets/kofrenot.ico"
        Width="1000" Height="680"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
  <!-- The main window. Closing it hides it: kofrenot stays in the notification area until Quit. -->
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <TextBlock VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="kofrenot" />

      <Button x:Name="SettingsButton"
              Width="40"
              Height="36"
              Padding="0"
              HorizontalAlignment="Right"
              Content="&#xE713;"
              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
              FontSize="16"
              ToolTip="Settings"
              Click="SettingsButton_Click" />

      <!-- A newer release is available (see Settings > About). Over the button's corner; clicks go through. -->
      <Ellipse x:Name="UpdateMark"
               Width="9"
               Height="9"
               Margin="0,4,4,0"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               Fill="{DynamicResource SystemFillColorCautionBrush}"
               IsHitTestVisible="False"
               Visibility="Collapsed" />
    </Grid>

    <!-- Placeholder until the first features land (see docs/ROADMAP.md). -->
    <TextBlock Grid.Row="1"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Opacity="0.6"
               Text="Your notes will be here." />

    <TextBlock x:Name="VersionText"
               Grid.Row="2"
               HorizontalAlignment="Right"
               FontSize="11"
               Opacity="0.6" />
  </Grid>
</Window>
