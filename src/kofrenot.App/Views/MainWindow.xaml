<Window x:Class="Kofrenot.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kofrenot.UI.Views"
        Title="kofrenot"
        Icon="/Assets/kofrenot.ico"
        Width="1000" Height="680"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
  <!-- The main window: one input box to find and add nodes and links. Closing it (or Esc) hides it:
       kofrenot stays in the notification area until Quit. -->
  <Window.Resources>
    <ResourceDictionary Source="SharedStyles.xaml" />
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- The registered vaults, shown when there are several: choosing one closes the open vault
           and opens it. A vault whose folder cannot be reached is marked, and cannot be chosen. -->
      <StackPanel Margin="0,0,12,0" Orientation="Horizontal">
      <ComboBox x:Name="VaultBox"
                MinWidth="140"
                MaxWidth="240"
                VerticalAlignment="Center"
                ToolTip="Vault (Ctrl+1 to Ctrl+9: the vault at that place)"
                Visibility="Collapsed"
                DropDownOpened="VaultBox_DropDownOpened"
                SelectionChanged="VaultBox_SelectionChanged">
        <ComboBox.ItemContainerStyle>
          <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
            <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
          </Style>
        </ComboBox.ItemContainerStyle>
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <!-- Locks the open vault (Ctrl+L): closed, still in the list; Unlock opens it again. -->
      <Button x:Name="LockButton"
              Margin="4,0,0,0"
              Padding="8,4"
              VerticalAlignment="Center"
              Style="{StaticResource FlatButton}"
              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
              FontSize="14"
              Content="&#xE72E;"
              ToolTip="Lock the vault (Ctrl+L): it stays locked, also after a restart, until Unlock, which asks its pass phrase"
              Visibility="Collapsed"
              Click="LockButton_Click" />
      </StackPanel>

      <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource HeadingText}" Text="kofrenot" />

      <!-- The tabs: the search, then the views open on this device. A click selects one, ⚙ edits
           the selected view, × closes a view's tab, + opens a view in a new tab. -->
      <StackPanel x:Name="TabStrip" Grid.Column="1" Margin="0,0,56,0" VerticalAlignment="Center" Orientation="Horizontal" Visibility="Collapsed">
        <ItemsControl x:Name="TabsList" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,4,0" Padding="10,4" Cursor="Hand" Style="{StaticResource RowFrame}" MouseLeftButtonDown="Tab_MouseLeftButtonDown">
                <Grid>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TabText" VerticalAlignment="Center" FontSize="{StaticResource BodyFontSize}" Text="{Binding Name}" />
                    <Button x:Name="EditButton"
                            Margin="6,0,0,0"
                            Padding="4,2"
                            Style="{StaticResource FlatButton}"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            FontSize="10"
                            Content="&#xE713;"
                            ToolTip="Edit what this view shows"
                            Visibility="Collapsed"
                            Click="EditTab_Click" />
                    <Button x:Name="CloseButton"
                            Margin="6,0,0,0"
                            Padding="4,2"
                            Style="{StaticResource FlatButton}"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            FontSize="10"
                            Content="&#xE711;"
                            ToolTip="Close this tab"
                            Click="CloseTab_Click" />
                  </StackPanel>
                  <Border x:Name="Underline"
                          Height="3"
                          Margin="0,0,0,-4"
                          VerticalAlignment="Bottom"
                          CornerRadius="1.5"
                          Background="{DynamicResource AccentFillColorDefaultBrush}"
                          Visibility="Collapsed" />
                </Grid>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                  <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                  <Setter TargetName="TabText" Property="FontWeight" Value="SemiBold" />
                  <Setter TargetName="EditButton" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tab.IsSearch}" Value="True">
                  <Setter TargetName="CloseButton" Property="Visibility" Value="Collapsed" />
                  <Setter TargetName="EditButton" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="AddTabButton"
                Padding="8,4"
                Style="{StaticResource FlatButton}"
                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                FontSize="12"
                Content="&#xE710;"
                ToolTip="Open a view in a tab"
                Click="AddTab_Click" />
      </StackPanel>

      <Button x:Name="SettingsButton"
              Grid.Column="1"
              Width="40"
              Height="36"
              Padding="0"
              HorizontalAlignment="Right"
              Content="&#xE713;"
              FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
              FontSize="16"
              ToolTip="Settings"
              Click="SettingsButton_Click" />

      <!-- A newer release is available (see Settings > About). Over the button's corner; clicks go through. -->
      <Ellipse x:Name="UpdateMark"
               Grid.Column="1"
               Width="9"
               Height="9"
               Margin="0,4,4,0"
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               Fill="{DynamicResource SystemFillColorCautionBrush}"
               IsHitTestVisible="False"
               Visibility="Collapsed" />
    </Grid>

    <!-- Enter adds (or opens the selected node), Up/Down select a node or choose among homonyms,
         Tab switches the side of a link, Esc clears then hides. -->
    <Grid x:Name="InputArea" Grid.Row="1" Margin="0,14,0,0">
      <TextBox x:Name="InputBox"
               Padding="8,6"
               FontSize="{StaticResource BodyFontSize}"
               TextChanged="InputBox_TextChanged"
               PreviewKeyDown="InputBox_PreviewKeyDown" />
      <TextBlock x:Name="InputPlaceholder"
                 Margin="12,0,0,0"
                 VerticalAlignment="Center"
                 FontSize="{StaticResource BodyFontSize}"
                 IsHitTestVisible="False"
                 Opacity="0.5"
                 Text="Dune relates to Frank Herbert" />
    </Grid>

    <TextBlock x:Name="PreviewText"
               Grid.Row="2"
               Margin="2,8,0,0"
               Opacity="0.8"
               TextWrapping="Wrap" />

    <!-- The nodes found, and the links of the exact matches; while the box is empty, the pinned
         nodes under a header. Each node has its picture (NodeVisualView). A row is highlighted
         when hovered; a click selects it (as Up/Down), a double-click or › opens its node's
         details. Nothing is focusable: typing stays in the input box. -->
    <ScrollViewer x:Name="ResultsArea" Grid.Row="3" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
      <ItemsControl x:Name="ResultsList" FontSize="{StaticResource BodyFontSize}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border x:Name="Frame" Margin="0,1" Style="{StaticResource RowFrame}" MouseLeftButtonDown="Result_MouseLeftButtonDown">
              <Grid>
                <Border x:Name="SelectionBar" Style="{StaticResource RowSelectionBar}" />
                <Grid Margin="6,1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <local:NodeVisualView x:Name="RowVisual" Margin="0,1,10,1" Visual="{Binding Visual}" />
                  <TextBlock x:Name="RowText" Grid.Column="1" VerticalAlignment="Center" Text="{Binding Text}" />
                  <Button x:Name="OpenButton" Grid.Column="2" Style="{StaticResource OpenRowButton}" Click="OpenResult_Click" />
                </Grid>
              </Grid>
            </Border>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding Node}" Value="{x:Null}">
                <Setter TargetName="OpenButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Frame" Property="Background" Value="Transparent" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsLink}" Value="True">
                <Setter TargetName="RowText" Property="Margin" Value="24,0,0,0" />
                <Setter TargetName="RowText" Property="Opacity" Value="0.75" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsHeader}" Value="True">
                <Setter TargetName="RowText" Property="Margin" Value="0,8,0,2" />
                <Setter TargetName="RowVisual" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="RowText" Property="FontSize" Value="{StaticResource CaptionFontSize}" />
                <Setter TargetName="RowText" Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="RowText" Property="Opacity" Value="0.6" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsChosen}" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible" />
                <Setter TargetName="RowText" Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="RowText" Property="Opacity" Value="1" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Instead of the search: the view of the selected tab. -->
    <local:ViewPanel x:Name="ViewContent"
                     Grid.Row="1"
                     Grid.RowSpan="3"
                     Margin="0,10,0,0"
                     Visibility="Collapsed"
                     OpenNode="ViewContent_OpenNode" />

    <!-- Instead of the search or a view: the details of a node, and the nodes linked to it. -->
    <local:NodeDetailsPanel x:Name="DetailsPanel"
                            Grid.Row="1"
                            Grid.RowSpan="3"
                            Margin="0,10,0,0"
                            Visibility="Collapsed"
                            BackToSearch="DetailsPanel_BackToSearch" />

    <!-- Instead of the input: no vault chosen yet, or it is locked. -->
    <StackPanel x:Name="StatePanel"
                Grid.Row="1"
                Grid.RowSpan="3"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="Collapsed">
      <TextBlock x:Name="StateText"
                 MaxWidth="460"
                 Opacity="0.8"
                 TextAlignment="Center"
                 TextWrapping="Wrap" />
      <Button x:Name="StateButton"
              Margin="0,14,0,0"
              Padding="14,5"
              HorizontalAlignment="Center"
              Click="StateButton_Click" />
    </StackPanel>

    <Grid Grid.Row="4">
      <TextBlock x:Name="VaultText" Style="{StaticResource FooterText}" Margin="0,0,160,0" />
      <TextBlock x:Name="VersionText" HorizontalAlignment="Right" Style="{StaticResource FooterText}" />
    </Grid>
  </Grid>
</Window>
