<UserControl x:Class="Kofrenot.UI.Views.NodeDetailsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kofrenot.UI.Views"
             Focusable="True"
             FocusVisualStyle="{x:Null}">
  <!-- The details of a node, in the main window instead of the search: breadcrumb; properties,
       with a dataset's file (DatasetPanel) on their right; a note's content (NoteEditor); links,
       across the width. Up/Down or a click select a link, Enter, a double-click or › opens its
       other node, Esc goes back one level. -->
  <UserControl.Resources>
    <ResourceDictionary Source="SharedStyles.xaml" />
  </UserControl.Resources>

  <!-- Properties and links in the size of the search rows. -->
  <Grid TextElement.FontSize="{StaticResource BodyFontSize}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <!-- Properties, and next to them a dataset's file: takes room only while its viewer shows a text. -->
      <RowDefinition x:Name="TopRow" Height="Auto" />
      <!-- The note editor: takes room only for a note. -->
      <RowDefinition x:Name="NoteRow" Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ItemsControl x:Name="Breadcrumb" FontSize="{StaticResource SecondaryFontSize}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="Separator" Margin="4,0" VerticalAlignment="Center" Opacity="0.5" Text="›" />
            <Button x:Name="Item"
                    Style="{StaticResource FlatButton}"
                    FontSize="{StaticResource SecondaryFontSize}"
                    Content="{Binding Label}"
                    Click="BreadcrumbItem_Click" />
          </StackPanel>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Depth}" Value="0">
              <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
              <Setter TargetName="Item" Property="IsEnabled" Value="False" />
              <Setter TargetName="Item" Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Properties on the left; a dataset's file on the right (the column has no width for other types). -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="ContentColumn" Width="0" />
      </Grid.ColumnDefinitions>

      <StackPanel VerticalAlignment="Top">
        <!-- The name: a click or F2 edits it in place (Enter or leaving it renames, Esc cancels). Under it, a conflict
             between names given on two devices, each name offered to keep. -->
        <StackPanel Margin="2,14,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="NameText"
                       VerticalAlignment="Center"
                       Cursor="IBeam"
                       Style="{StaticResource TitleText}"
                       ToolTip="Click to rename (F2)"
                       MouseLeftButtonDown="NameText_MouseLeftButtonDown" />
            <TextBox x:Name="NameBox"
                     FontSize="{StaticResource TitleFontSize}"
                     Visibility="Collapsed"
                     TextChanged="NameBox_TextChanged"
                     LostKeyboardFocus="NameBox_LostKeyboardFocus" />
            <!-- Pinned nodes are listed while the input box is empty. Filled pin: pinned. -->
            <Button x:Name="PinButton"
                    Grid.Column="1"
                    Margin="2,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource FlatButton}"
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                    FontSize="14"
                    Click="PinButton_Click" />
          </Grid>
          <TextBlock x:Name="RenameText" Margin="0,4,0,0" Opacity="0.8" TextWrapping="Wrap" Visibility="Collapsed" />

          <StackPanel x:Name="ConflictPanel" Margin="0,6,0,0" Visibility="Collapsed">
            <TextBlock Foreground="{DynamicResource SystemFillColorCautionBrush}"
                       TextWrapping="Wrap"
                       Text="Renamed on two devices before they synced. Keep:" />
            <ItemsControl x:Name="ConflictNames">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Margin="0,4,8,0" Padding="10,2" Focusable="False" Content="{Binding}" Click="KeepName_Click" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>

        <Grid Margin="2,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Opacity="0.7" Text="Type" />
          <TextBlock x:Name="TypeText" Grid.Column="1" />
          <TextBlock Grid.Row="1" Opacity="0.7" Text="Created" />
          <TextBlock x:Name="CreatedText" Grid.Row="1" Grid.Column="1" />
          <!-- A view: what it shows, and Edit… to change it. -->
          <TextBlock x:Name="ShowsLabel" Grid.Row="2" Margin="0,4,0,0" VerticalAlignment="Center" Opacity="0.7" Text="Shows" Visibility="Collapsed" />
          <StackPanel x:Name="ShowsPanel" Grid.Row="2" Grid.Column="1" Margin="0,4,0,0" Orientation="Horizontal" Visibility="Collapsed">
            <TextBlock x:Name="ShowsText" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Margin="10,0,0,0" Padding="10,2" Content="Edit…" Click="EditView_Click" />
          </StackPanel>
        </Grid>
      </StackPanel>

      <local:DatasetPanel x:Name="DatasetBox" Grid.Column="1" Margin="16,0,0,0" Visibility="Collapsed" />
    </Grid>

    <local:NoteEditor x:Name="NoteBox" Grid.Row="2" Visibility="Collapsed" />

    <TextBlock x:Name="LinksHeader" Grid.Row="3" Margin="2,18,0,4" FontWeight="SemiBold" />

    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Focusable="False">
      <ItemsControl x:Name="LinksList" Grid.IsSharedSizeScope="True">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border x:Name="Frame" Margin="0,1" Style="{StaticResource RowFrame}" MouseLeftButtonDown="Link_MouseLeftButtonDown">
              <Grid>
                <Border x:Name="SelectionBar" Style="{StaticResource RowSelectionBar}" />
                <Grid x:Name="Row">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="LinkType" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="Type" Margin="10,0,16,0" VerticalAlignment="Center" Opacity="0.75" Text="{Binding Type}" />
                  <local:NodeVisualView Grid.Column="1" Margin="0,1,10,1" Visual="{Binding Visual}" />
                  <TextBlock x:Name="Other" Grid.Column="2" VerticalAlignment="Center" Text="{Binding Other}" TextTrimming="CharacterEllipsis" />
                  <Button x:Name="Open" Grid.Column="3" Style="{StaticResource OpenRowButton}" Click="OpenLink_Click" />
                </Grid>
              </Grid>
            </Border>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible" />
                <Setter TargetName="Other" Property="FontWeight" Value="SemiBold" />
              </DataTrigger>
              <DataTrigger Binding="{Binding CanOpen}" Value="False">
                <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                <Setter TargetName="Open" Property="Visibility" Value="Hidden" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
