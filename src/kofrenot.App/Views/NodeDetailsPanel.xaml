<UserControl x:Class="Kofrenot.UI.Views.NodeDetailsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             FocusVisualStyle="{x:Null}">
  <!-- The details of a node, in the main window instead of the search: breadcrumb, properties,
       links. Up/Down select a link, Enter or › opens its other node, Esc goes back one level. -->
  <UserControl.Resources>
    <ResourceDictionary Source="SharedStyles.xaml" />
  </UserControl.Resources>

  <!-- Properties and links in the size of the search rows. -->
  <Grid TextElement.FontSize="{StaticResource RowFontSize}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ItemsControl x:Name="Breadcrumb" FontSize="{StaticResource BreadcrumbFontSize}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="Separator" Margin="4,0" VerticalAlignment="Center" Opacity="0.5" Text="›" />
            <Button x:Name="Item"
                    Style="{StaticResource FlatButton}"
                    FontSize="{StaticResource BreadcrumbFontSize}"
                    Content="{Binding Label}"
                    Click="BreadcrumbItem_Click" />
          </StackPanel>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Depth}" Value="0">
              <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
              <Setter TargetName="Item" Property="IsEnabled" Value="False" />
              <Setter TargetName="Item" Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock x:Name="NameText" Grid.Row="1" Margin="2,14,0,0" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />

    <Grid Grid.Row="2" Margin="2,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Opacity="0.7" Text="Type" />
      <TextBlock x:Name="TypeText" Grid.Column="1" />
      <TextBlock Grid.Row="1" Opacity="0.7" Text="Created" />
      <TextBlock x:Name="CreatedText" Grid.Row="1" Grid.Column="1" />
    </Grid>

    <TextBlock x:Name="LinksHeader" Grid.Row="3" Margin="2,18,0,4" FontWeight="SemiBold" />

    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Focusable="False">
      <ItemsControl x:Name="LinksList" Grid.IsSharedSizeScope="True">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid x:Name="Row" Margin="0,1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="LinkType" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="Type" Margin="6,0,16,0" VerticalAlignment="Center" Opacity="0.75" Text="{Binding Type}" />
              <TextBlock x:Name="Other" Grid.Column="1" VerticalAlignment="Center" Text="{Binding Other}" TextTrimming="CharacterEllipsis" />
              <Button x:Name="Open" Grid.Column="2" Style="{StaticResource OpenRowButton}" Click="OpenLink_Click" />
            </Grid>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Other" Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="Type" Property="Text" Value="{Binding Type, StringFormat=› {0}}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding CanOpen}" Value="False">
                <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                <Setter TargetName="Open" Property="Visibility" Value="Hidden" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
