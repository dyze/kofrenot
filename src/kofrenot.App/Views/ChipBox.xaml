<UserControl x:Class="Kofrenot.UI.Views.ChipBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kofrenot.UI.Views">
  <!-- A box typed as the input box (ChipInput): the labels over its start, its text after them, the proposal in grey
       after the text, and a placeholder while it is empty. The home's input box and the Link box of the details. -->
  <UserControl.Resources>
    <ResourceDictionary Source="SharedStyles.xaml" />
  </UserControl.Resources>
  <Grid>
    <TextBox x:Name="Box"
             Padding="8,6"
             TextChanged="Box_TextChanged"
             SelectionChanged="Box_SelectionChanged"
             GotKeyboardFocus="Box_KeyboardFocusChanged"
             LostKeyboardFocus="Box_KeyboardFocusChanged"
             PreviewKeyDown="Box_PreviewKeyDown" />
    <ItemsControl x:Name="Chips"
                  Margin="8,0,0,0"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Focusable="False"
                  IsHitTestVisible="False"
                  SizeChanged="Chips_SizeChanged">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,0,4,0">
            <Rectangle x:Name="NewOutline"
                       RadiusX="4"
                       RadiusY="4"
                       Fill="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                       Stroke="{DynamicResource SystemFillColorSuccessBrush}"
                       StrokeThickness="1"
                       StrokeDashArray="3 2"
                       Visibility="Collapsed" />
            <Border x:Name="Chip"
                    Padding="5,1,7,1"
                    CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
              <StackPanel Orientation="Horizontal">
                <local:NodeVisualView x:Name="ChipVisual" Width="16" Height="16" Margin="0,0,4,0" Visual="{Binding Visual}" />
                <local:IconView x:Name="NewMark"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Size="{StaticResource CaptionFontSize}"
                                Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                ToolTip="New node: added with Enter"
                                Visibility="Collapsed" Kind="add" />
                <TextBlock x:Name="ChipText" VerticalAlignment="Center" Text="{Binding Text}" />
                <TextBlock x:Name="HomonymMark"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource CaptionFontSize}"
                           Opacity="0.7"
                           Text="{Binding HomonymMark}" />
              </StackPanel>
            </Border>
          </Grid>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsNew}" Value="True">
              <Setter TargetName="NewOutline" Property="Visibility" Value="Visible" />
              <Setter TargetName="NewMark" Property="Visibility" Value="Visible" />
              <Setter TargetName="ChipVisual" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Chip" Property="BorderBrush" Value="Transparent" />
              <Setter TargetName="Chip" Property="Background" Value="Transparent" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsLinkType}" Value="True">
              <Setter TargetName="ChipVisual" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Chip" Property="Padding" Value="7,1" />
              <Setter TargetName="Chip" Property="BorderBrush" Value="Transparent" />
              <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            </DataTrigger>
            <!-- A qualifier: its name, then its value once the next one is typed; outlined in the accent's colour. -->
            <DataTrigger Binding="{Binding IsQualifier}" Value="True">
              <Setter TargetName="ChipVisual" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Chip" Property="Padding" Value="7,1" />
              <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
              <Setter TargetName="Chip" Property="Background" Value="Transparent" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HomonymMark}" Value="">
              <Setter TargetName="HomonymMark" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock x:Name="ProposalText"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               IsHitTestVisible="False"
               Opacity="0.45" />
    <!-- Several proposals (ChipBox.ProposalList): the rest of each, under one another from the caret; the one selected
         on the line of the text, where the proposal in grey would be. -->
    <Popup x:Name="ProposalList"
           AllowsTransparency="True"
           Placement="Relative"
           PlacementTarget="{Binding ElementName=Box}"
           StaysOpen="True">
      <Border Padding="0,3"
              Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
              BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,1,1"
              CornerRadius="0,4,4,0"
              TextElement.FontFamily="{Binding FontFamily, ElementName=Box}"
              TextElement.FontSize="{Binding FontSize, ElementName=Box}">
        <ItemsControl x:Name="ProposalItems" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border x:Name="Row"
                      Height="{Binding Height}"
                      Padding="0,0,10,0"
                      Background="Transparent"
                      Cursor="Hand"
                      MouseLeftButtonDown="ProposalRow_MouseLeftButtonDown">
                <TextBlock x:Name="RowText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding Rest}" />
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                  <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                  <Setter TargetName="RowText" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </Popup>
    <TextBlock x:Name="PlaceholderText"
               Margin="12,0,0,0"
               VerticalAlignment="Center"
               IsHitTestVisible="False"
               Opacity="0.5" />
  </Grid>
</UserControl>
