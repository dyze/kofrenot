<UserControl x:Class="Kofrenot.UI.Views.NodeVisualView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="26"
             Height="26"
             Focusable="False">
  <!-- A node's picture in a row or a dataset's header: its icon, replaced by its thumbnail once
       read, with a dot of its colour at the bottom right. No visual: nothing shown, the room kept
       (so link rows stay aligned). -->
  <Grid>
    <Viewbox>
      <TextBlock x:Name="Glyph"
                 Margin="2"
                 FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                 Opacity="0.7" />
    </Viewbox>
    <Border x:Name="ThumbnailFrame" CornerRadius="3" ClipToBounds="True" Visibility="Collapsed">
      <Image x:Name="Thumbnail" Stretch="UniformToFill" />
    </Border>
    <Ellipse x:Name="ColorDot"
             HorizontalAlignment="Right"
             VerticalAlignment="Bottom"
             Stroke="{DynamicResource SolidBackgroundFillColorBaseBrush}"
             StrokeThickness="1.5"
             Visibility="Collapsed" />
  </Grid>
</UserControl>
