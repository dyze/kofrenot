<UserControl x:Class="Kofrenot.UI.Views.GraphPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kofrenot.UI.Views">
  <!-- A graph view's content: cards joined by lines, laid out by Core (GraphLayout). Drag a card to move it (kept in
       the vault), drag the background to pan, the wheel zooms; a double-click or Enter opens a node's details. -->
  <UserControl.Resources>
    <ResourceDictionary Source="SharedStyles.xaml" />
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
      <Button Margin="0,0,4,0" Padding="8,4" Style="{StaticResource FlatButton}" ToolTip="Show the whole graph (Home)" Click="Fit_Click">
        <StackPanel Orientation="Horizontal">
          <local:IconView VerticalAlignment="Center" Size="12" Kind="eye" />
          <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Fit" />
        </StackPanel>
      </Button>
      <Button x:Name="ResetButton" Margin="0,0,4,0" Padding="8,4" Style="{StaticResource FlatButton}" ToolTip="Give the nodes moved by hand back to the layout" Click="Reset_Click">
        <StackPanel Orientation="Horizontal">
          <local:IconView VerticalAlignment="Center" Size="12" Kind="sync" />
          <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Reset layout" />
        </StackPanel>
      </Button>
      <TextBlock x:Name="CutNote" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" Visibility="Collapsed" />
    </StackPanel>

    <!-- The surface takes the mouse and the keys; the board under it is moved and zoomed as a whole. -->
    <Border x:Name="Surface"
            Grid.Row="1"
            Background="Transparent"
            ClipToBounds="True"
            Focusable="True"
            FocusVisualStyle="{x:Null}"
            MouseLeftButtonDown="Surface_MouseLeftButtonDown"
            MouseMove="Surface_MouseMove"
            MouseLeftButtonUp="Surface_MouseLeftButtonUp"
            LostMouseCapture="Surface_LostMouseCapture"
            MouseWheel="Surface_MouseWheel"
            KeyDown="Surface_KeyDown"
            SizeChanged="Surface_SizeChanged">
      <Canvas x:Name="Board">
        <Canvas x:Name="Lines" />
        <Canvas x:Name="Cards" />
      </Canvas>
    </Border>
  </Grid>
</UserControl>
