<UserControl x:Class="Kofrenot.UI.Views.GraphPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kofrenot.UI.Views">
  <!-- A graph view's content: cards joined by lines, laid out by Core (GraphLayout). Drag a card to move it, with the
       other cards selected (kept in the vault), drag the background to select the cards in a box, Ctrl+click to add
       or take out one, drag the handle of the card selected to another card to link them, right-drag to pan, the
       wheel zooms; a double-click or Enter opens a node's details; a right-click on a card or a line offers its actions.
       Its buttons (Fit, Reset layout, Link names) and its search are on the view's bar (ViewPanel). -->
  <UserControl.Resources>
    <ResourceDictionary Source="SharedStyles.xaml" />
  </UserControl.Resources>

  <Grid>
    <!-- The surface takes the mouse and the keys; the board under it is moved and zoomed as a whole. -->
    <Border x:Name="Surface"
            Background="Transparent"
            ClipToBounds="True"
            Focusable="True"
            FocusVisualStyle="{x:Null}"
            MouseLeftButtonDown="Surface_MouseLeftButtonDown"
            MouseMove="Surface_MouseMove"
            MouseLeftButtonUp="Surface_MouseLeftButtonUp"
            MouseRightButtonDown="Surface_MouseRightButtonDown"
            MouseRightButtonUp="Surface_MouseRightButtonUp"
            LostMouseCapture="Surface_LostMouseCapture"
            MouseWheel="Surface_MouseWheel"
            KeyDown="Surface_KeyDown"
            SizeChanged="Surface_SizeChanged">
      <Canvas x:Name="Board">
        <Canvas x:Name="Lines" />
        <Canvas x:Name="Cards" />
        <!-- While a link is dragged from the handle of the card selected (GraphPanel.Link). -->
        <Path x:Name="LinkBand" IsHitTestVisible="False" StrokeThickness="2" StrokeDashArray="4 3" Stroke="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
        <!-- While the background is dragged: the cards it touches are selected (GraphPanel.Selection). -->
        <Rectangle x:Name="SelectionBox" IsHitTestVisible="False" Stroke="{DynamicResource AccentFillColorDefaultBrush}" Fill="{DynamicResource SubtleFillColorSecondaryBrush}" Visibility="Collapsed" />
      </Canvas>
    </Border>

    <TextBlock x:Name="CutNote" Margin="8,4,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource SecondaryText}" IsHitTestVisible="False" Visibility="Collapsed" />

    <!-- The link types and their colours, when there are several. -->
    <Border x:Name="Legend"
            Margin="8"
            Padding="8,6"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            IsHitTestVisible="False"
            Visibility="Collapsed">
      <StackPanel x:Name="LegendRows" />
    </Border>

    <local:GraphMinimap x:Name="Minimap" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" />
  </Grid>
</UserControl>
