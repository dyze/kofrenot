<Window x:Class="Kofrenot.UI.Views.VaultImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kofrenot.UI.Views"
        Title="Import from a vault"
        Icon="/Assets/kofrenot.ico"
        Width="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SourceInitialized="Window_SourceInitialized">
  <!-- Imports › From a vault…: another vault (read, never written), a query typed on it (the input
       box's ? syntax, with its completion), and whether each node's subtree comes too. Preview… plans it. -->
  <Window.Resources>
    <ResourceDictionary Source="SharedStyles.xaml" />
  </Window.Resources>

  <StackPanel Margin="20,18,20,16">
    <TextBlock Style="{StaticResource HeadingText}" Text="Import from a vault" />
    <TextBlock Margin="0,8,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
               Text="The nodes a query finds in another of your vaults, with their fields, note or file and links. Imported again, they are updated. That vault is only read." />

    <TextBlock Margin="0,14,0,4" Text="Vault" />
    <ComboBox x:Name="VaultBox" DisplayMemberPath="Name" SelectionChanged="VaultBox_SelectionChanged" />

    <TextBlock Margin="0,12,0,4" Text="Query" />
    <local:ChipBox x:Name="QueryBox" Placeholder="?Book:" PreviewKeyDown="QueryBox_PreviewKeyDown" />
    <TextBlock x:Name="CountText" Margin="2,6,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />

    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
      <CheckBox x:Name="SubtreeBox" VerticalAlignment="Center" Content="With their subtree by" />
      <ComboBox x:Name="LinkTypeBox" Margin="8,0,0,0" MinWidth="160" DisplayMemberPath="Name" />
    </StackPanel>

    <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button x:Name="PreviewButton" MinWidth="90" Padding="12,4" Content="Preview…" IsDefault="True" IsEnabled="False" Style="{DynamicResource AccentButtonStyle}" Click="Preview_Click" />
      <Button MinWidth="90" Margin="8,0,0,0" Padding="12,4" Content="Cancel" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
