<Window x:Class="Kofrenot.UI.Views.ShareDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="kofrenot"
        Icon="/Assets/kofrenot.ico"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SourceInitialized="Window_SourceInitialized">
  <!-- Shares a server vault: someone found by email, the fingerprint of their key compared with
       them, then a role. Share is enabled once the fingerprint is said to match. -->
  <Window.Resources>
    <ResourceDictionary Source="SharedStyles.xaml" />
  </Window.Resources>

  <StackPanel Margin="20,18,20,16">
    <TextBlock Style="{StaticResource HeadingText}" Text="Share the vault" />
    <TextBlock x:Name="PlaceText" Margin="0,4,0,0" Opacity="0.7" TextTrimming="CharacterEllipsis" />

    <TextBlock Margin="0,14,0,4" Text="Their email on the server" />
    <StackPanel Orientation="Horizontal">
      <TextBox x:Name="EmailBox" Width="300" Padding="4,3" TextChanged="EmailBox_TextChanged" />
      <Button x:Name="FindButton" Margin="8,0,0,0" Padding="12,4" Content="Find" IsDefault="True" Click="FindButton_Click" />
    </StackPanel>

    <StackPanel x:Name="FoundPanel" Visibility="Collapsed">
      <TextBlock Margin="0,14,0,4" TextWrapping="Wrap"
                 Text="Their key's fingerprint. Read it to them by phone or in person: they see theirs in Settings > Server. If it differs, do not share: the server may have given you another key." />
      <TextBox x:Name="FingerprintBox"
               IsReadOnly="True"
               Padding="6,6"
               FontFamily="Consolas"
               FontSize="{StaticResource SecondaryFontSize}" />
      <CheckBox x:Name="MatchesCheckBox"
                Margin="0,10,0,0"
                Content="They read the same fingerprint"
                Checked="MatchesCheckBox_Changed"
                Unchecked="MatchesCheckBox_Changed" />

      <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
        <TextBlock Width="60" VerticalAlignment="Center" Text="Role" />
        <ComboBox x:Name="RoleBox" Width="200" SelectedIndex="0">
          <ComboBoxItem Content="Reader: reads only" />
          <ComboBoxItem Content="Writer: reads and adds" />
        </ComboBox>
      </StackPanel>
    </StackPanel>

    <TextBlock x:Name="ErrorText"
               Margin="0,10,0,0"
               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
               TextWrapping="Wrap"
               Visibility="Collapsed" />

    <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button x:Name="ShareButton" MinWidth="90" Padding="12,4" Content="Share" IsEnabled="False" Click="ShareButton_Click" />
      <Button MinWidth="90" Margin="8,0,0,0" Padding="12,4" Content="Cancel" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
