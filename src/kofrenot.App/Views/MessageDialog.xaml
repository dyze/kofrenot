<Window x:Class="Kofrenot.UI.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="kofrenot"
        Icon="/Assets/kofrenot.ico"
        MinWidth="320" MaxWidth="520"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SourceInitialized="Window_SourceInitialized">
  <!-- A message box in the app's theme (the Windows one ignores it). Enter and Esc close it. -->
  <Grid Margin="20,18,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="MessageText" VerticalAlignment="Center" TextWrapping="Wrap" />

    <Button x:Name="OkButton"
            Grid.Row="1"
            MinWidth="90"
            Margin="0,20,0,0"
            Padding="12,4"
            HorizontalAlignment="Right"
            Content="OK"
            IsDefault="True"
            IsCancel="True" />
  </Grid>
</Window>
