<UserControl x:Class="Kofrenot.UI.Views.KeyBindingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="Section_IsVisibleChanged">
  <!-- Settings > Key bindings: every shortcut, by area, read only. The global hotkeys are changed
       in General and Vault; shown again each time the tab shows. -->
  <ItemsControl x:Name="AreaList" Margin="0,6,0,0" Grid.IsSharedSizeScope="True" Focusable="False">
    <ItemsControl.ItemTemplate>
      <DataTemplate>
        <StackPanel Margin="0,8,0,0">
          <TextBlock FontWeight="SemiBold" Text="{Binding Area}" />
          <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Bindings}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Keys" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Margin="0,0,16,0" FontFamily="Consolas, Courier New" Text="{Binding Keys}" />
                  <TextBlock Grid.Column="1" Opacity="0.8" TextWrapping="Wrap" Text="{Binding Action}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
