<Window x:Class="Kofrenot.UI.Views.RecordImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="kofrenot"
        Icon="/Assets/kofrenot.ico"
        Width="720"
        Height="680"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SourceInitialized="Window_SourceInitialized">
  <!-- What importing a file does, before anything is written: each group with its records (to check:
       Update, Add as new or Skip; new and updated: ticked), the values not imported, the rules left
       out. Import n writes the n nodes chosen; Cancel writes nothing. -->
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SharedStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="VisibleWhen" />
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="20,18,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="HeadingText" Style="{StaticResource HeadingText}" TextTrimming="CharacterEllipsis" />
    <ItemsControl x:Name="CountList" Grid.Row="1" Margin="0,8,0,0" Focusable="False">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Margin="0,0,6,0" Padding="8,2" Content="{Binding Header}" Style="{StaticResource FlatButton}" Tag="{Binding}" Click="Count_Click" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <ScrollViewer Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
      <ItemsControl x:Name="GroupList" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Expander Margin="0,4" Header="{Binding Header}" IsExpanded="{Binding IsExpanded, Mode=OneTime}">
              <ItemsControl Margin="8,4,0,0" ItemsSource="{Binding Rows}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <CheckBox VerticalAlignment="Top" IsChecked="{Binding IsChecked}" Visibility="{Binding HasCheck, Converter={StaticResource VisibleWhen}}" />
                      <TextBlock Grid.Column="1" Margin="0,0,8,0" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                      <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource SecondaryText}" Text="{Binding Details}" TextWrapping="Wrap" />
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Visibility="{Binding HasChoice, Converter={StaticResource VisibleWhen}}">
                          <RadioButton Margin="0,0,12,0" Content="Update" GroupName="{Binding ChoiceGroup}" IsChecked="{Binding IsUpdate}" />
                          <RadioButton Margin="0,0,12,0" Content="Add as new" GroupName="{Binding ChoiceGroup}" IsChecked="{Binding IsAddAsNew}" />
                          <RadioButton Content="Skip" GroupName="{Binding ChoiceGroup}" IsChecked="{Binding IsSkip}" />
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Expander>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock x:Name="ProblemsText" Grid.Row="3" Margin="0,10,0,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Visibility="Collapsed" />

    <StackPanel Grid.Row="4" Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button x:Name="ImportButton" MinWidth="90" Padding="12,4" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Click="Import_Click" />
      <Button MinWidth="90" Margin="8,0,0,0" Padding="12,4" Content="Cancel" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
