<Window x:Class="Kofrenot.UI.Views.PassphraseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="kofrenot"
        Icon="/Assets/kofrenot.ico"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SourceInitialized="Window_SourceInitialized">
  <!-- Asks the pass phrase of a vault: once to unlock or upgrade it, twice to create it (with its name) or change it. Enter: OK, Esc: Cancel. -->
  <Window.Resources>
    <ResourceDictionary Source="SharedStyles.xaml" />
  </Window.Resources>

  <StackPanel Margin="20,18,20,16">
    <TextBlock x:Name="TitleText" Style="{StaticResource HeadingText}" />
    <TextBlock x:Name="FolderText" Margin="0,4,0,0" Opacity="0.7" TextTrimming="CharacterEllipsis" />
    <TextBlock x:Name="HintText" Margin="0,10,0,0" TextWrapping="Wrap" />

    <StackPanel x:Name="NamePanel" Visibility="Collapsed">
      <TextBlock Margin="0,14,0,4" Text="Name" />
      <TextBox x:Name="NameBox" Padding="4,3" ToolTip="Stored, encrypted, in the vault: every device shows it. Rename it later in Settings > Vault" />
    </StackPanel>

    <TextBlock x:Name="FirstLabel" Margin="0,14,0,4" Text="Pass phrase" />
    <PasswordBox x:Name="FirstBox" Padding="6,4" />

    <StackPanel x:Name="SecondPanel" Visibility="Collapsed">
      <TextBlock Margin="0,10,0,4" Text="Pass phrase again" />
      <PasswordBox x:Name="SecondBox" Padding="6,4" />
    </StackPanel>

    <CheckBox x:Name="RememberCheckBox"
              Margin="0,14,0,0"
              Content="Remember pass phrase on this computer"
              ToolTip="Kept by Windows for your account only: kofrenot then opens the vault without asking" />

    <Button x:Name="RecoveryButton"
            Margin="0,10,0,0"
            HorizontalAlignment="Left"
            Style="{StaticResource FlatButton}"
            Content="Lost it? Use the recovery key"
            ToolTip="The key shown once when the vault was created or upgraded"
            Visibility="Collapsed"
            Click="RecoveryButton_Click" />

    <TextBlock x:Name="ErrorText"
               Margin="0,10,0,0"
               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
               TextWrapping="Wrap"
               Visibility="Collapsed" />

    <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button x:Name="OkButton" MinWidth="90" Padding="12,4" IsDefault="True" Click="OkButton_Click" />
      <Button MinWidth="90" Margin="8,0,0,0" Padding="12,4" Content="Cancel" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
