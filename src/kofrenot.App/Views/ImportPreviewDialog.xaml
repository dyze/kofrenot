<Window x:Class="Kofrenot.UI.Views.ImportPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="kofrenot"
        Icon="/Assets/kofrenot.ico"
        Width="560"
        SizeToContent="Height"
        MaxHeight="640"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SourceInitialized="Window_SourceInitialized">
  <!-- What dropped files and folders will add, before anything is: a dataset per file, a node per
       folder (its content indented under it), the items skipped, the node they go under (or their destination, to change). Enter: Add. Esc: Cancel. -->
  <Window.Resources>
    <ResourceDictionary Source="SharedStyles.xaml" />
  </Window.Resources>

  <Grid Margin="20,18,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="HeadingText" Style="{StaticResource HeadingText}" />
    <TextBlock x:Name="UnderText" Grid.Row="1" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
    <!-- Where the items go when they were not dropped on a node: the last destination of this vault, or none. -->
    <DockPanel x:Name="DestinationBar" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed">
      <Button x:Name="NoDestinationButton" Margin="4,0,0,0" Padding="8,2" Content="None" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" ToolTip="Import without a parent: the items are then listed beside a tree, as unlinked" Click="NoDestination_Click" />
      <Button Margin="8,0,0,0" Padding="8,2" Content="Change…" DockPanel.Dock="Right" Style="{StaticResource FlatButton}" ToolTip="Choose a tree view, then the node the items go under" Click="ChangeDestination_Click" />
      <TextBlock x:Name="DestinationText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </DockPanel>

    <ScrollViewer Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
      <ItemsControl x:Name="RowsList" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="80" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="{Binding Indent}" Orientation="Horizontal">
                <TextBlock Margin="0,0,6,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="+" />
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="8,0,0,0"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                           Text="{Binding Tag}"
                           ToolTip="{Binding TagTip}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Style="{StaticResource SecondaryText}" Text="{Binding Type}" />
              <TextBlock Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}" Text="{Binding Size}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock x:Name="SkippedText" Grid.Row="3" Margin="0,10,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Visibility="Collapsed" />

    <StackPanel Grid.Row="4" Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button x:Name="AddButton" MinWidth="90" Padding="12,4" Content="Add" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Click="AddButton_Click" />
      <Button MinWidth="90" Margin="8,0,0,0" Padding="12,4" Content="Cancel" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
