<UserControl x:Class="Kofrenot.UI.Views.ViewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kofrenot.UI.Views">
  <!-- A view tab's content: its tree (children read when expanded; copy, cut, paste, delete), its list or its graph. Enter or a
       double-click opens a node's details; Back returns here. -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SharedStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- A list's panel while it shows cards: in columns, each card under the shortest one. -->
      <ItemsPanelTemplate x:Key="CardsPanel">
        <local:MasonryPanel />
      </ItemsPanelTemplate>
      <!-- A card's item: no fill behind it (its colour is see-through), a ring instead: grey when
           hovered, the accent colour when selected; its own BorderBrush (set in code) while a card
           dragged over it would take its place. -->
      <Style x:Key="CardItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Ring" Padding="2" BorderThickness="2" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="12">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <!-- A list's row: as compact as the tree's (the theme's is sized for touch). -->
      <Style x:Key="ListRowItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- The actions on the view (ViewPanel.Actions): New, and in a tree the operations on the node selected; a graph's own (ViewPanel.Graph);
         at the right, the search (ViewPanel.Search): it goes to the nodes found, it hides none. -->
    <Grid x:Name="ActionBar" Margin="0,0,0,8" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Button x:Name="NewButton" Margin="0,0,4,0" Padding="8,4" Style="{StaticResource FlatButton}" ToolTip="Add a node (in a tree: under the node selected)" Click="New_Click">
          <StackPanel Orientation="Horizontal">
            <local:IconView VerticalAlignment="Center" Size="{StaticResource LabeledIconSize}" Kind="add" />
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="New" />
          </StackPanel>
        </Button>
        <Button x:Name="EditButton" Margin="0,0,4,0" Padding="8,4" Style="{StaticResource FlatButton}" ToolTip="Open the node selected, to edit it (Enter)" Click="Edit_Click">
          <StackPanel Orientation="Horizontal">
            <local:IconView VerticalAlignment="Center" Size="{StaticResource LabeledIconSize}" Kind="edit" />
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Edit" />
          </StackPanel>
        </Button>
        <Button x:Name="RenameButton" Margin="0,0,4,0" Padding="8,4" Style="{StaticResource FlatButton}" ToolTip="Rename the node selected, here (F2)" Click="Rename_Click">
          <StackPanel Orientation="Horizontal">
            <local:IconView VerticalAlignment="Center" Size="{StaticResource LabeledIconSize}" Kind="rename" />
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Rename" />
          </StackPanel>
        </Button>
        <Button x:Name="CutButton" Margin="0,0,4,0" Padding="8,4" Style="{StaticResource FlatButton}" ToolTip="Cut the node selected, to move it (Ctrl+X)" Click="Cut_Click">
          <StackPanel Orientation="Horizontal">
            <local:IconView VerticalAlignment="Center" Size="{StaticResource LabeledIconSize}" Kind="cut" />
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Cut" />
          </StackPanel>
        </Button>
        <Button x:Name="CopyButton" Margin="0,0,4,0" Padding="8,4" Style="{StaticResource FlatButton}" ToolTip="Copy the node selected, with everything under it (Ctrl+C)" Click="Copy_Click">
          <StackPanel Orientation="Horizontal">
            <local:IconView VerticalAlignment="Center" Size="{StaticResource LabeledIconSize}" Kind="copy" />
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Copy" />
          </StackPanel>
        </Button>
        <Button x:Name="PasteButton" Margin="0,0,4,0" Padding="8,4" Style="{StaticResource FlatButton}" ToolTip="Paste under the node selected: moved when cut, a copy otherwise (Ctrl+V)" Click="Paste_Click">
          <StackPanel Orientation="Horizontal">
            <local:IconView VerticalAlignment="Center" Size="{StaticResource LabeledIconSize}" Kind="paste" />
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Paste" />
          </StackPanel>
        </Button>
        <Button x:Name="DeleteButton" Margin="0,0,4,0" Padding="8,4" Style="{StaticResource FlatButton}" Click="Delete_Click">
          <StackPanel Orientation="Horizontal">
            <local:IconView VerticalAlignment="Center" Size="{StaticResource LabeledIconSize}" Kind="delete" />
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Delete" />
          </StackPanel>
        </Button>
        <ToggleButton x:Name="DetailsButton" Margin="8,0,4,0" Padding="8,4" ToolTip="Show the type, size and last change of each node" Click="Details_Click">
          <StackPanel Orientation="Horizontal">
            <local:IconView VerticalAlignment="Center" Size="{StaticResource LabeledIconSize}" Kind="view-details" />
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Details" />
          </StackPanel>
        </ToggleButton>
        <!-- A tree: the unlinked nodes beside it (ViewPanel.Unlinked), to drag into it. -->
        <ToggleButton x:Name="UnlinkedButton" Margin="8,0,4,0" Padding="8,4" ToolTip="Show the nodes without a parent beside the tree, to drag them into it" Click="Unlinked_Click">
          <StackPanel Orientation="Horizontal">
            <local:IconView VerticalAlignment="Center" Size="{StaticResource LabeledIconSize}" Kind="unlink" />
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Unlinked" />
          </StackPanel>
        </ToggleButton>
        <!-- A list: its nodes as cards (ViewPanel.Cards), not rows. -->
        <ToggleButton x:Name="CardsButton" Margin="8,0,4,0" Padding="8,4" ToolTip="Show the nodes as cards, with a preview of each" Click="Cards_Click">
          <StackPanel Orientation="Horizontal">
            <local:IconView VerticalAlignment="Center" Size="{StaticResource LabeledIconSize}" Kind="view-cards" />
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Cards" />
          </StackPanel>
        </ToggleButton>
        <!-- A graph (GraphPanel): fit it, give the nodes moved by hand back to the layout, write the link names on the lines. -->
        <Button x:Name="FitButton" Margin="0,0,4,0" Padding="8,4" Style="{StaticResource FlatButton}" ToolTip="Show the whole graph (Home)" Click="Fit_Click">
          <StackPanel Orientation="Horizontal">
            <local:IconView VerticalAlignment="Center" Size="{StaticResource LabeledIconSize}" Kind="eye" />
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Fit" />
          </StackPanel>
        </Button>
        <Button x:Name="ResetLayoutButton" Margin="0,0,4,0" Padding="8,4" Style="{StaticResource FlatButton}" ToolTip="Give the nodes moved by hand back to the layout" Click="ResetLayout_Click">
          <StackPanel Orientation="Horizontal">
            <local:IconView VerticalAlignment="Center" Size="{StaticResource LabeledIconSize}" Kind="sync" />
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Reset layout" />
          </StackPanel>
        </Button>
        <ToggleButton x:Name="LinkNamesButton" Margin="8,0,4,0" Padding="8,4" ToolTip="Write the name of each link on its line" Click="LinkNames_Click">
          <StackPanel Orientation="Horizontal">
            <local:IconView VerticalAlignment="Center" Size="{StaticResource LabeledIconSize}" Kind="link" />
            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Link names" />
          </StackPanel>
        </ToggleButton>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Grid Width="220">
          <TextBox x:Name="SearchBox"
                   Padding="6,3"
                   VerticalContentAlignment="Center"
                   ToolTip="Find a node in this view (Ctrl+F). Enter: the next one, Shift+Enter: the previous one, Esc: clear"
                   TextChanged="SearchBox_TextChanged"
                   PreviewKeyDown="SearchBox_PreviewKeyDown" />
          <TextBlock x:Name="SearchPlaceholder"
                     Margin="10,0,0,0"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False"
                     Opacity="0.5"
                     Text="Find in this view" />
        </Grid>
        <TextBlock x:Name="SearchCount" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" />
        <Button x:Name="SearchNextButton"
                Margin="4,0,0,0"
                Padding="6,4"
                Style="{StaticResource FlatButton}"
                ToolTip="The next node found (Enter)"
                IsEnabled="False"
                Click="SearchNext_Click">
          <local:IconView Size="{StaticResource LabeledIconSize}" Kind="arrow-down" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- The tree or the list, and beside a tree, on demand, the unlinked nodes to drag into it (ViewPanel.Unlinked). -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="UnlinkedColumn" Width="0" />
      </Grid.ColumnDefinitions>
      <local:UnlinkedPane x:Name="Unlinked"
                          Grid.Column="1"
                          Margin="16,0,0,0"
                          Visibility="Collapsed" />

    <Grid Background="Transparent">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- With Details on: the names of the columns each row shows (ViewPanel.Details), aligned with them. -->
      <!-- Right margin: the room a tree row leaves on its right (ViewPanel.TreeRowRightRoom). -->
      <Grid x:Name="DetailsHeader" Margin="4,0,24,4" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="90" />
          <ColumnDefinition Width="150" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource SecondaryText}" Text="Name" />
        <TextBlock Grid.Column="1" Style="{StaticResource SecondaryText}" Text="Type" />
        <TextBlock Grid.Column="2" Margin="0,0,16,0" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}" Text="Size" />
        <TextBlock Grid.Column="3" Style="{StaticResource SecondaryText}" Text="Modified" />
      </Grid>

      <!-- A query view: Name, then the link phrase of each column (ViewPanel.Query), aligned with its rows. -->
      <Grid x:Name="QueryHeader" Margin="4,0,24,4" Visibility="Collapsed" />

      <TextBlock x:Name="MessageText"
                 Grid.Row="1"
                 MaxWidth="460"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Opacity="0.8"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 Visibility="Collapsed" />

      <!-- No focus frame around the tree or the list, nor their rows: the selected row shows where the keyboard is. -->
      <TreeView x:Name="Tree"
                Grid.Row="1"
                FocusVisualStyle="{x:Null}"
                Background="Transparent"
                BorderThickness="0"
                FontSize="{StaticResource BodyFontSize}"
                Visibility="Collapsed"
                KeyDown="Content_KeyDown"
                MouseDoubleClick="Content_MouseDoubleClick"
                SelectedItemChanged="Tree_SelectedItemChanged"
                PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                PreviewMouseLeftButtonUp="Tree_PreviewMouseLeftButtonUp"
                PreviewMouseMove="Tree_PreviewMouseMove"
                QueryContinueDrag="DragInside_QueryContinueDrag"
                AllowDrop="True"
                DragOver="Tree_DragOver"
                DragLeave="Tree_DragLeave"
                Drop="Tree_Drop"
                ContextMenuOpening="Tree_ContextMenuOpening"
                SizeChanged="Tree_SizeChanged">
        <!-- Filled when it opens: copy, cut, paste, delete (ViewPanel.Operations). -->
        <TreeView.ContextMenu>
          <ContextMenu />
        </TreeView.ContextMenu>
      </TreeView>

      <ListBox x:Name="List"
               Grid.Row="1"
               FocusVisualStyle="{x:Null}"
               Background="Transparent"
               BorderThickness="0"
               FontSize="{StaticResource BodyFontSize}"
               Visibility="Collapsed"
               SelectionMode="Extended"
               KeyDown="Content_KeyDown"
               MouseDoubleClick="Content_MouseDoubleClick"
               PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
               PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"
               PreviewMouseMove="List_PreviewMouseMove"
               QueryContinueDrag="DragInside_QueryContinueDrag"
               AllowDrop="True"
               DragOver="List_DragOver"
               DragLeave="List_DragLeave"
               Drop="List_Drop"
               SelectionChanged="List_SelectionChanged"
               ContextMenuOpening="List_ContextMenuOpening">
        <!-- Filled when it opens: New…, Edit, Rename (ViewPanel.Actions). -->
        <ListBox.ContextMenu>
          <ContextMenu />
        </ListBox.ContextMenu>
        <!-- Its rows are built in code (ViewPanel.RowOf), as the tree's, or its cards (ViewPanel.CardOf). -->
      </ListBox>

      <!-- A graph: its own bar (Fit, Reset layout) over its cards. -->
      <local:GraphPanel x:Name="GraphBoard" Grid.Row="1" Visibility="Collapsed" />
    </Grid>
    </Grid>
  </Grid>
</UserControl>
