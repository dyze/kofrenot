<UserControl x:Class="Kofrenot.UI.Views.TaskListBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- A note shown as a task list (TaskList), in MarkdownBox: a row per item, a checkbox and its
       text; the items not checked first, then the items checked under their count. Rows are built
       in code (TaskListBox.xaml.cs). -->
  <UserControl.Resources>
    <ResourceDictionary Source="SharedStyles.xaml" />
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="0,6,0,0">
      <StackPanel x:Name="OpenRows" />
      <Button x:Name="AddButton"
              HorizontalAlignment="Left"
              Padding="6,4"
              Style="{StaticResource FlatButton}"
              Click="Add_Click">
        <StackPanel Orientation="Horizontal" Opacity="0.7">
          <TextBlock VerticalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Text="&#xE710;" />
          <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="List item" />
        </StackPanel>
      </Button>
      <TextBlock x:Name="CheckedHeader" Margin="6,10,0,2" Style="{StaticResource CaptionText}" />
      <StackPanel x:Name="DoneRows" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
