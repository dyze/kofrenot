<UserControl x:Class="Kofrenot.UI.Views.NodeTypesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kofrenot.UI.Views">
  <!-- Settings > Node types: the user's node types, a line each with its icon, colour and fields; ✎ opens
       the form in place of the list, × removes it (asked first). New node type… opens the form for a new
       one; Copy from… lists another vault's, to copy them here. Stored in the vault. -->
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SharedStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <BooleanToVisibilityConverter x:Key="VisibleWhen" />

      <Style x:Key="LineButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="11" />
      </Style>

      <DataTemplate x:Key="IconItem" DataType="{x:Type local:IconChoice}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Width="20" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="{Binding Glyph}" />
          <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <StackPanel>
    <TextBlock x:Name="StateText" Margin="0,10,0,0" Opacity="0.7" TextWrapping="Wrap" />

    <!-- The list of the user's types. -->
    <StackPanel x:Name="ListPanel">
      <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
        <Button x:Name="NewTypeButton" Padding="12,4" Content="New node type…" Click="NewType_Click" />
        <Button x:Name="CopyFromButton"
                Margin="6,0,0,0"
                Padding="12,4"
                Content="Copy from…"
                ToolTip="Copy node types from another of your vaults"
                Click="CopyFrom_Click" />
      </StackPanel>
      <ItemsControl x:Name="TypeList" Margin="0,10,12,0" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:TypeLine}">
            <Grid Margin="0,3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="{Binding Glyph}" />
              <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock FontWeight="SemiBold" Text="{Binding Type.Type.Name}" />
                <Ellipse Width="8" Height="8" Margin="6,1,0,0" Fill="{Binding Fill}" Visibility="{Binding HasColor, Converter={StaticResource VisibleWhen}}" />
              </StackPanel>
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Opacity="0.7" TextWrapping="Wrap" Text="{Binding Fields}" />
                <TextBlock Foreground="{DynamicResource SystemFillColorCautionBrush}"
                           TextWrapping="Wrap"
                           Text="Changed on two devices: change it to settle which to keep."
                           Visibility="{Binding Type.IsConflict, Converter={StaticResource VisibleWhen}}" />
              </StackPanel>
              <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button Style="{StaticResource LineButton}" Content="&#xE70F;" ToolTip="Change this node type" Click="EditType_Click" />
                <Button Style="{StaticResource LineButton}" Content="&#xE711;" ToolTip="Remove this node type" Click="RemoveType_Click" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Another vault's types, each ticked to copy it here, with what copying does; in place of the list. -->
    <StackPanel x:Name="CopyPanel" Margin="0,10,12,0" Visibility="Collapsed">
      <TextBlock x:Name="CopyTitle" FontWeight="SemiBold" />
      <TextBlock Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap" Text="Types are copied with their fields, not the values of their nodes. Copied again later, a type is updated." />
      <ItemsControl x:Name="CopyList" Margin="0,8,0,0" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:CopyLine}">
            <Grid Margin="0,3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <CheckBox MinWidth="0" VerticalAlignment="Center" IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanCopy}" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="{Binding Glyph}" />
              <TextBlock Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Copy.Type.Type.Name}" />
              <TextBlock Grid.Column="3" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" Text="{Binding Copy.Status}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
        <Button Padding="16,4" Content="Copy" Style="{DynamicResource AccentButtonStyle}" Click="Copy_Click" />
        <Button Margin="6,0,0,0" Padding="16,4" Content="Cancel" Click="CancelCopy_Click" />
      </StackPanel>
    </StackPanel>

    <!-- The form of one type, new or changed, in place of the list. -->
    <StackPanel x:Name="FormPanel" Margin="0,10,12,0" Visibility="Collapsed">
      <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="80" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock VerticalAlignment="Center" Text="Name" />
        <TextBox x:Name="NameBox" Grid.Column="1" Width="220" HorizontalAlignment="Left" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" KeyDown="FormBox_KeyDown" />
        <TextBlock Grid.Row="1" Margin="0,6,0,0" VerticalAlignment="Center" Text="Icon" />
        <ComboBox Grid.Row="1"
                  Grid.Column="1"
                  Width="220"
                  Margin="0,6,0,0"
                  HorizontalAlignment="Left"
                  ItemTemplate="{StaticResource IconItem}"
                  ItemsSource="{x:Static local:IconChoice.All}"
                  SelectedItem="{Binding Icon}" />
        <TextBlock Grid.Row="2" Margin="0,6,0,0" VerticalAlignment="Center" Text="Colour" />
        <ComboBox Grid.Row="2"
                  Grid.Column="1"
                  Width="220"
                  Margin="0,6,0,0"
                  HorizontalAlignment="Left"
                  ItemsSource="{x:Static local:NodeTypeForm.Colors}"
                  SelectedItem="{Binding Color}" />
      </Grid>

      <TextBlock Margin="0,14,0,4" FontWeight="SemiBold" Text="Fields" />
      <ItemsControl ItemsSource="{Binding Fields}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:FieldRow}">
            <StackPanel Margin="0,2" Orientation="Horizontal">
              <TextBox Width="160" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="Its name" KeyDown="FormBox_KeyDown" />
              <ComboBox Width="110" Margin="6,0,0,0" ItemsSource="{x:Static local:FieldRow.Kinds}" SelectedItem="{Binding Kind}" />
              <TextBox Width="200"
                       Margin="6,0,0,0"
                       Text="{Binding Choices, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="Its options, separated by commas: Novel, Short story"
                       Visibility="{Binding IsChoice, Converter={StaticResource VisibleWhen}}"
                       KeyDown="FormBox_KeyDown" />
              <Button Style="{StaticResource LineButton}" Content="&#xE711;" ToolTip="Take this field out" Click="RemoveField_Click" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Margin="0,4,0,0" Padding="10,2" HorizontalAlignment="Left" Content="Add field" Click="AddField_Click" />

      <TextBlock Margin="0,10,0,0" Opacity="0.7" TextWrapping="Wrap" Text="{Binding Status}" />
      <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
        <Button Padding="16,4" Content="Save" IsEnabled="{Binding CanApply}" Style="{DynamicResource AccentButtonStyle}" Click="Save_Click" />
        <Button Margin="6,0,0,0" Padding="16,4" Content="Cancel" Click="Cancel_Click" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
