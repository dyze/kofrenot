<Window x:Class="Kofrenot.UI.Views.ImageDatasetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kofrenot.UI.Views"
        Title="kofrenot"
        Icon="/Assets/kofrenot.ico"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SourceInitialized="Window_SourceInitialized">
  <!-- Chooses an image dataset of the vault for an image field, found by its name: nothing is copied.
       Typing filters, Down goes to the list, Enter: Choose, Esc: Cancel. -->
  <Window.Resources>
    <ResourceDictionary Source="SharedStyles.xaml" />
  </Window.Resources>

  <StackPanel Margin="20,18,20,16">
    <TextBlock x:Name="Heading" Style="{StaticResource HeadingText}" />
    <TextBox x:Name="SearchBox" Margin="0,10,0,8" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
    <ListBox x:Name="ImageList" Height="260" MouseDoubleClick="ImageList_MouseDoubleClick">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <!-- Its thumbnail (its type's icon until read), its name, then its file's. -->
          <StackPanel Margin="0,2" Orientation="Horizontal">
            <local:NodeVisualView Width="40" Height="40" Visual="{Binding Visual}" />
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Choice.Node.Name}" />
              <TextBlock FontSize="{StaticResource CaptionFontSize}" Opacity="0.7" Text="{Binding Choice.Image.File.Name}" />
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock x:Name="EmptyText" Margin="0,6,0,0" Opacity="0.7" Text="No image dataset of that name." Visibility="Collapsed" />

    <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button MinWidth="90" Padding="12,4" Content="Choose" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" Click="ChooseButton_Click" />
      <Button MinWidth="90" Margin="8,0,0,0" Padding="12,4" Content="Cancel" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
