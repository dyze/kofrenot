<Window x:Class="Kofrenot.UI.Views.DeleteServerVaultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kofrenot.UI.Views"
        Title="kofrenot"
        Icon="/Assets/kofrenot.ico"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SourceInitialized="Window_SourceInitialized">
  <!-- Asks before deleting a server vault: its name typed again, and the account's password.
       Delete is enabled once the name matches. Esc: Cancel. -->
  <Window.Resources>
    <ResourceDictionary Source="SharedStyles.xaml" />
  </Window.Resources>

  <StackPanel Margin="20,18,20,16">
    <TextBlock Style="{StaticResource HeadingText}" Text="Delete from the server" />
    <TextBlock x:Name="HintText" Margin="0,6,0,0" TextWrapping="Wrap" />

    <TextBlock Margin="0,14,0,4" Text="The vault's name" />
    <TextBox x:Name="NameBox" Padding="4,3" TextChanged="NameBox_TextChanged" />

    <TextBlock Margin="0,10,0,4" Text="Password of the server account" />
    <local:SecretBox x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged" />

    <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button x:Name="DeleteButton" MinWidth="90" Padding="12,4" Content="Delete" IsEnabled="False" Click="DeleteButton_Click" />
      <Button MinWidth="90" Margin="8,0,0,0" Padding="12,4" Content="Cancel" IsCancel="True" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
