<UserControl x:Class="Kofrenot.UI.Views.UnlinkedPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Beside a tree, on demand: the nodes without a parent, the newest first, at most 100 (UnlinkedNodes),
       narrowed by a filter. Dragged onto a node of the tree, they go under it; a double-click opens one. -->
  <UserControl.Resources>
    <ResourceDictionary Source="SharedStyles.xaml" />
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel>
      <TextBlock x:Name="CountText" Margin="8,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}" />
      <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Unlinked" />
    </DockPanel>

    <Grid Grid.Row="1" Margin="0,8,0,0">
      <TextBox x:Name="FilterBox" Padding="6,3" VerticalContentAlignment="Center" ToolTip="Show only the unlinked nodes whose name matches" TextChanged="FilterBox_TextChanged" />
      <TextBlock x:Name="FilterPlaceholder" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.5" Text="Filter" />
    </Grid>

    <ListBox x:Name="List"
             Grid.Row="2"
             Margin="0,8,0,0"
             FocusVisualStyle="{x:Null}"
             Background="Transparent"
             BorderThickness="0"
             FontSize="{StaticResource BodyFontSize}"
             SelectionMode="Extended"
             MouseDoubleClick="List_MouseDoubleClick"
             PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
             PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"
             PreviewMouseMove="List_PreviewMouseMove" />

    <TextBlock x:Name="HintText" Grid.Row="3" Margin="0,8,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
  </Grid>
</UserControl>
