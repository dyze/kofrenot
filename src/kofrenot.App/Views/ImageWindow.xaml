<Window x:Class="Kofrenot.UI.Views.ImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="kofrenot image"
        Icon="/Assets/kofrenot.ico"
        Width="900"
        Height="650"
        MinWidth="300"
        MinHeight="200"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
  <!-- A dataset's image, decrypted in memory only: fitted to the window, then zoomed by the wheel
       (around the pointer) or +/- (0 fits again), moved by dragging when larger. One window, reused by
       each image opened; Esc closes it. -->
  <Window.Resources>
    <ResourceDictionary Source="SharedStyles.xaml" />
  </Window.Resources>

  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer x:Name="Scroller"
                  Focusable="False"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  PreviewMouseWheel="Scroller_PreviewMouseWheel"
                  PreviewMouseLeftButtonDown="Scroller_PreviewMouseLeftButtonDown"
                  PreviewMouseMove="Scroller_PreviewMouseMove"
                  PreviewMouseLeftButtonUp="Scroller_PreviewMouseLeftButtonUp"
                  LostMouseCapture="Scroller_LostMouseCapture"
                  ScrollChanged="Scroller_ScrollChanged"
                  SizeChanged="Scroller_SizeChanged">
      <Image x:Name="Picture"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             RenderOptions.BitmapScalingMode="HighQuality"
             Stretch="Fill" />
    </ScrollViewer>
    <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,6,0,0" Style="{StaticResource CaptionText}" />
  </Grid>
</Window>
