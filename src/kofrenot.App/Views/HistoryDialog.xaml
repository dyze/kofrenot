<Window x:Class="Kofrenot.UI.Views.HistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="kofrenot"
        Icon="/Assets/kofrenot.ico"
        Width="620"
        SizeToContent="Height"
        MaxHeight="640"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SourceInitialized="Window_SourceInitialized">
  <!-- A node's versions, newest first (NodeHistory): when, what, and what it held; Restore on each
       one the node no longer has, or of a conflict. Esc: Close. -->
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SharedStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="VisibleWhen" />
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="20,18,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="HeadingText" Style="{StaticResource HeadingText}" />

    <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
      <ItemsControl x:Name="RowsList" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryText}" Text="{Binding When}" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" Text="{Binding What}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
              <Button Grid.Column="3"
                      Padding="10,1"
                      HorizontalAlignment="Right"
                      Content="Restore"
                      Focusable="False"
                      Visibility="{Binding CanRestore, Converter={StaticResource VisibleWhen}}"
                      Click="Restore_Click" />
              <TextBlock Grid.Column="3"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Center"
                         Style="{StaticResource SecondaryText}"
                         Text="current"
                         Visibility="{Binding IsOnlyCurrent, Converter={StaticResource VisibleWhen}}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Button Grid.Row="2" MinWidth="90" Margin="0,20,0,0" Padding="12,4" HorizontalAlignment="Right" Content="Close" IsCancel="True" />
  </Grid>
</Window>
