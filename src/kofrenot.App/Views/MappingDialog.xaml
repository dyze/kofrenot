<Window x:Class="Kofrenot.UI.Views.MappingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="kofrenot"
        Icon="/Assets/kofrenot.ico"
        Width="720"
        Height="720"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SourceInitialized="Window_SourceInitialized">
  <!-- A mapping's name and definition: the type its records become, the keys naming a node (the first a record
       has), the match field, each field's key and whether it is another name, the link rules. A sample file
       offers its keys, suggests rules by name, and shows its first records as they would be imported. -->
  <Window.Resources>
    <ResourceDictionary Source="SharedStyles.xaml" />
  </Window.Resources>

  <Grid Margin="20,18,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="HeadingText" Style="{StaticResource HeadingText}" />

    <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel Margin="0,0,8,0">
        <TextBlock Text="Name" />
        <TextBox x:Name="NameBox" Margin="0,4,0,0" />

        <TextBlock Margin="0,14,0,0" Text="Records become nodes of" />
        <ComboBox x:Name="TypeBox" Margin="0,4,0,0" DisplayMemberPath="Name" SelectionChanged="TypeBox_SelectionChanged" />

        <DockPanel Margin="0,14,0,0">
          <Button Padding="10,3" Content="Choose a sample file…" DockPanel.Dock="Left" Click="Sample_Click" />
          <TextBlock x:Name="SampleText" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"
                     Text="Optional: its keys are offered, and its first records shown as they would be imported." />
        </DockPanel>

        <TextBlock Margin="0,14,0,0" Text="Name: the keys giving a node's name, in order (the first a record has)" />
        <TextBox x:Name="NameKeysBox" Margin="0,4,0,0" ToolTip="Keys separated by commas: title_fr, title" />

        <TextBlock Margin="0,14,0,0" Text="Match: the field finding a record's node, before its names" />
        <ComboBox x:Name="MatchBox" Margin="0,4,0,0" />

        <TextBlock Margin="0,18,0,0" Style="{StaticResource HeadingText}" FontSize="{StaticResource SecondaryFontSize}" Text="Fields" />
        <TextBlock x:Name="NoFieldText" Margin="0,4,0,0" Style="{StaticResource SecondaryText}" Text="This type has no field kofrenot can import." />
        <ItemsControl x:Name="FieldRows" Margin="0,4,0,0" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding Keys}" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="The key read for this field; empty: not imported" />
                <CheckBox Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Content="Other name" IsChecked="{Binding IsOtherName}"
                          ToolTip="Its values are also names of the node: compared with the names when finding a record's node" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Margin="0,18,0,0" Style="{StaticResource HeadingText}" FontSize="{StaticResource SecondaryFontSize}" Text="Links" />
        <ItemsControl x:Name="LinkRows" Margin="0,4,0,0" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox IsEditable="True" ItemsSource="{Binding Keys}" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" ToolTip="The key whose values name the linked nodes" />
                <ComboBox Grid.Column="1" Margin="6,0,0,0" ItemsSource="{Binding Verbs}" SelectedItem="{Binding Verb}" ToolTip="The link, read from the imported node" />
                <ComboBox Grid.Column="2" Margin="6,0,0,0" ItemsSource="{Binding NodeTypes}" SelectedItem="{Binding NodeType}" DisplayMemberPath="Name"
                          ToolTip="The type of the linked nodes: found by name, else added" />
                <Button Grid.Column="3" Margin="6,0,0,0" Padding="8,2" Content="Remove" Style="{StaticResource FlatButton}" Tag="{Binding}" Click="RemoveLink_Click" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Margin="0,4,0,0" Padding="10,3" HorizontalAlignment="Left" Content="Add a link" Style="{StaticResource FlatButton}" Click="AddLink_Click" />

        <DockPanel Margin="0,18,0,0">
          <Button x:Name="TryButton" Padding="10,3" Content="Try on the sample" DockPanel.Dock="Right" IsEnabled="False" Style="{StaticResource FlatButton}" Click="Try_Click" />
          <TextBlock Style="{StaticResource HeadingText}" FontSize="{StaticResource SecondaryFontSize}" Text="Sample" />
        </DockPanel>
        <TextBlock x:Name="TryText" Margin="0,4,0,0" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Text="Choose a sample file to see its first records as they would be imported." />
      </StackPanel>
    </ScrollViewer>

    <TextBlock x:Name="ErrorText" Grid.Row="2" Margin="0,10,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Visibility="Collapsed" />

    <StackPanel Grid.Row="3" Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button MinWidth="90" Padding="12,4" Content="Save" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Click="Save_Click" />
      <Button MinWidth="90" Margin="8,0,0,0" Padding="12,4" Content="Cancel" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
