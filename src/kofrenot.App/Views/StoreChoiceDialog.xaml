<Window x:Class="Kofrenot.UI.Views.StoreChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="kofrenot"
        Icon="/Assets/kofrenot.ico"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SourceInitialized="Window_SourceInitialized">
  <!-- Chooses a vault of the server not listed here yet, by the name the account keeps for it,
       else by its id. Enter: Add, Esc: Cancel. -->
  <Window.Resources>
    <ResourceDictionary Source="SharedStyles.xaml" />
  </Window.Resources>

  <StackPanel Margin="20,18,20,16">
    <TextBlock Style="{StaticResource HeadingText}" Text="Add a vault from the server" />
    <TextBlock Margin="0,6,0,10"
               Opacity="0.7"
               TextWrapping="Wrap"
               Text="A vault shows by its id until it is opened once on a device of yours: its name is then kept, encrypted, in your account. An empty one becomes a new vault." />
    <ListBox x:Name="StoreList" Height="180" DisplayMemberPath="Text" MouseDoubleClick="StoreList_MouseDoubleClick" />

    <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button x:Name="AddButton" MinWidth="90" Padding="12,4" Content="Add" Style="{DynamicResource AccentButtonStyle}" IsDefault="True" Click="AddButton_Click" />
      <Button MinWidth="90" Margin="8,0,0,0" Padding="12,4" Content="Cancel" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
