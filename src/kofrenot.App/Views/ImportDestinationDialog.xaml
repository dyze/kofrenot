<Window x:Class="Kofrenot.UI.Views.ImportDestinationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="kofrenot"
        Icon="/Assets/kofrenot.ico"
        Width="480"
        Height="520"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SourceInitialized="Window_SourceInitialized">
  <!-- Where an import goes: a tree view, then a node of its tree (children read when expanded). Enter: Choose. Esc: Cancel. -->
  <Window.Resources>
    <ResourceDictionary Source="SharedStyles.xaml" />
  </Window.Resources>

  <Grid Margin="20,18,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Style="{StaticResource HeadingText}" Text="Import into" />
    <ComboBox x:Name="ViewsBox" Grid.Row="1" Margin="0,12,0,0" DisplayMemberPath="Name" SelectionChanged="ViewsBox_SelectionChanged" />
    <TreeView x:Name="Tree" Grid.Row="2" Margin="0,10,0,0" SelectedItemChanged="Tree_SelectedItemChanged" />
    <TextBlock x:Name="NoViewText"
               Grid.Row="2"
               Margin="0,10,0,0"
               Style="{StaticResource SecondaryText}"
               Text="No tree view yet: add one (a view node), then choose here where imports go."
               TextWrapping="Wrap"
               Visibility="Collapsed" />

    <StackPanel Grid.Row="3" Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
      <Button x:Name="ChooseButton" MinWidth="90" Padding="12,4" Content="Choose" IsDefault="True" IsEnabled="False" Style="{DynamicResource AccentButtonStyle}" Click="ChooseButton_Click" />
      <Button MinWidth="90" Margin="8,0,0,0" Padding="12,4" Content="Cancel" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
