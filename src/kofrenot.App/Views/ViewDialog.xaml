<Window x:Class="Kofrenot.UI.Views.ViewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kofrenot.UI.Views"
        Title="kofrenot"
        Icon="/Assets/kofrenot.ico"
        Width="600"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SourceInitialized="Window_SourceInitialized"
        FontSize="{DynamicResource BodyFontSize}">
  <!-- Edits what a view shows. Enter saves, Esc cancels. -->
  <Window.Resources>
    <ResourceDictionary Source="SharedStyles.xaml" />
  </Window.Resources>

  <Grid Margin="20,18,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="TitleText" Style="{StaticResource HeadingText}" TextTrimming="CharacterEllipsis" />

    <TextBlock x:Name="ConflictText"
               Grid.Row="1"
               Margin="0,10,0,0"
               Foreground="{DynamicResource SystemFillColorCautionBrush}"
               Text="This view was edited on two computers before they synced: the latest definition is shown. Saving keeps yours."
               TextWrapping="Wrap"
               Visibility="Collapsed" />

    <local:ViewDefinitionEditor x:Name="Editor" Grid.Row="2" Margin="0,14,0,0" />

    <StackPanel Grid.Row="3"
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
      <Button x:Name="SaveButton"
              MinWidth="90"
              Padding="12,4"
              Content="Save"
              Style="{DynamicResource AccentButtonStyle}"
              IsDefault="True"
              Click="SaveButton_Click" />
      <Button MinWidth="90"
              Margin="8,0,0,0"
              Padding="12,4"
              Content="Cancel"
              IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
