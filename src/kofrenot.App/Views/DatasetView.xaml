<UserControl x:Class="Kofrenot.UI.Views.DatasetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- A dataset's text shown in its details, decrypted in memory only: its beginning, read only.
       An image opens in its own window (ImageWindow); other types say to export the file. -->
  <UserControl.Resources>
    <ResourceDictionary Source="SharedStyles.xaml" />
  </UserControl.Resources>

  <Grid Margin="0,10,0,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBox x:Name="TextView"
             FontFamily="Cascadia Mono, Consolas"
             FontSize="{StaticResource CaptionFontSize}"
             HorizontalScrollBarVisibility="Auto"
             IsReadOnly="True"
             TextWrapping="NoWrap"
             VerticalScrollBarVisibility="Auto"
             Visibility="Collapsed" />
    <TextBlock x:Name="MessageText"
               Grid.Row="1"
               Margin="0,4,0,0"
               Style="{StaticResource CaptionText}"
               TextWrapping="Wrap" />
  </Grid>
</UserControl>
