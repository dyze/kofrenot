<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Kofrenot.UI.Views"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Shared by every window, so the same kind of text has the same size everywhere.

       Title     26  the node a screen is about (details, creation step)
       Heading   20  a window's title, a section of Settings
       Body      18  the content: input box, rows, properties, links, note text, creation screen
       Secondary 16  what qualifies a line: breadcrumb, "New node", toolbar
       Caption   13  status lines, headers of the result rows
       Footer    11  the bottom line of a window -->
  <sys:Double x:Key="TitleFontSize">26</sys:Double>
  <sys:Double x:Key="HeadingFontSize">20</sys:Double>
  <sys:Double x:Key="BodyFontSize">18</sys:Double>
  <sys:Double x:Key="SecondaryFontSize">16</sys:Double>
  <sys:Double x:Key="CaptionFontSize">13</sys:Double>
  <sys:Double x:Key="FooterFontSize">11</sys:Double>

  <!-- Icons, by where they are, so the same kind of button has the same size everywhere.

       Action   18  an icon alone on a button: the details' header, the title bar, the note's Save
       Labeled  14  an icon before its label: toolbars, Paste, Drop files, + of the tabs
       Row      12  a small button in a row or a chip: remove, edit, close a tab, unlink -->
  <sys:Double x:Key="ActionIconSize">18</sys:Double>
  <sys:Double x:Key="LabeledIconSize">14</sys:Double>
  <sys:Double x:Key="RowIconSize">12</sys:Double>

  <Style x:Key="TitleText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource TitleFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="HeadingText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource HeadingFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="SecondaryText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource SecondaryFontSize}" />
    <Setter Property="Opacity" Value="0.7" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="CaptionText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
    <Setter Property="Opacity" Value="0.7" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="FooterText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FooterFontSize}" />
    <Setter Property="Opacity" Value="0.6" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- Flat, compact buttons: the theme's are sized for touch. -->
  <Style x:Key="FlatButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Focusable" Value="False" />
  </Style>

  <!-- A row of a list (search results, links): highlighted across its width when hovered, so its
       › button is clearly its own. A selected row's template sets SelectedRowBrush and shows an
       accent bar (RowSelectionBar). -->
  <Style x:Key="RowFrame" TargetType="Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="4" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- The bar at the start of a selected row, as in Windows' own lists. -->
  <Style x:Key="RowSelectionBar" TargetType="Border">
    <Setter Property="Width" Value="3" />
    <Setter Property="Margin" Value="0,6" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="CornerRadius" Value="1.5" />
    <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    <Setter Property="Visibility" Value="Collapsed" />
  </Style>

  <!-- › at the end of a row: opens the details of its node. -->
  <Style x:Key="OpenRowButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
    <Setter Property="Padding" Value="8,4" />
    <!-- Some content, so the template shows: an element can be in one button only, a template in each. -->
    <Setter Property="Content" Value="" />
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <local:IconView Size="12" Kind="chevron-right" />
        </DataTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ToolTip" Value="Details" />
  </Style>
</ResourceDictionary>
