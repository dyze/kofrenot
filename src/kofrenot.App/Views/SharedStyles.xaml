<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Shared by the search results and the node details, so their rows look the same. -->

  <!-- The size of the input box: rows read as part of the search. -->
  <sys:Double x:Key="RowFontSize">18</sys:Double>

  <sys:Double x:Key="BreadcrumbFontSize">16</sys:Double>

  <!-- Flat, compact buttons: the theme's are sized for touch. -->
  <Style x:Key="FlatButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Focusable" Value="False" />
  </Style>

  <!-- › at the end of a row: opens the details of its node. -->
  <Style x:Key="OpenRowButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Content" Value="&#xE76C;" />
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="ToolTip" Value="Details" />
  </Style>
</ResourceDictionary>
