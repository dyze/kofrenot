<UserControl x:Class="Kofrenot.UI.Views.VaultsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Settings > Vault: the registered vaults, in the order of the main window's vault box. The
       buttons act on the vault chosen in the list: its name (only when open), its folder, its
       remembered pass phrase. -->
  <StackPanel Margin="0,10,0,0">
    <TextBlock x:Name="HintText"
               Margin="0,0,0,8"
               Opacity="0.7"
               TextWrapping="Wrap"
               Text="No vault yet. Add one: an empty folder becomes a new vault, encrypted with a pass phrase; a folder holding a kofrenot vault adds it. Or keep it on a server (Settings > Server), synced across your devices." />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- As high as its rows, up to 150 px: then it scrolls. -->
      <ListBox x:Name="VaultList" MaxHeight="150" SelectionChanged="VaultList_SelectionChanged">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="10,3" />
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
              <TextBlock Opacity="0.7" Text="{Binding Folder}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel Grid.Column="1" Margin="8,0,0,0">
        <Button x:Name="AddButton" Padding="12,4" Content="Add..." ToolTip="A folder (an empty one becomes a new vault), a new vault on the server, or one of the server's vaults" Click="AddButton_Click">
          <Button.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Folder..." ToolTip="An empty folder becomes a new vault; a folder holding a kofrenot vault adds it" Click="AddFolder_Click" />
              <MenuItem Header="New vault on the server" ToolTip="A new vault kept on the server, synced across your devices" Click="CreateOnServer_Click" />
              <MenuItem Header="Vault from the server..." ToolTip="One of your vaults on the server, downloaded to this computer" Click="AddFromServer_Click" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
        <Button x:Name="RemoveButton" Margin="0,6,0,0" Padding="12,4" Content="Remove" ToolTip="Takes the vault out of the list: its folder is not touched" Click="RemoveButton_Click" />
        <Button x:Name="UpButton" Margin="0,6,0,0" Padding="12,4" Content="Up" Click="UpButton_Click" />
        <Button x:Name="DownButton" Margin="0,6,0,0" Padding="12,4" Content="Down" Click="DownButton_Click" />
      </StackPanel>
    </Grid>

    <StackPanel x:Name="DetailsPanel" Margin="0,12,0,0">
      <StackPanel Orientation="Horizontal">
        <TextBlock Width="110" VerticalAlignment="Center" Text="Name" />
        <TextBox x:Name="NameBox" Width="220" KeyDown="NameBox_KeyDown" TextChanged="NameBox_TextChanged" />
        <Button x:Name="RenameButton" Margin="8,0,0,0" Padding="12,4" Content="Rename" Click="RenameButton_Click" />
      </StackPanel>
      <TextBlock x:Name="NameStatusText" Margin="110,4,0,0" Opacity="0.7" TextWrapping="Wrap" />

      <!-- Focus the box, then press the shortcut: it shows kofrenot on this vault, or hides it. -->
      <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
        <TextBlock Width="110" VerticalAlignment="Center" Text="Hotkey" />
        <TextBox x:Name="HotkeyBox"
                 Width="160"
                 IsReadOnly="True"
                 IsReadOnlyCaretVisible="True"
                 ToolTip="Click, then press the shortcut that shows kofrenot on this vault: Ctrl, Alt or Win with a letter, a digit or F1 to F24"
                 PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
        <Button x:Name="ClearHotkeyButton" Margin="8,0,0,0" Padding="12,4" Content="None" ToolTip="No hotkey for this vault" Click="ClearHotkeyButton_Click" />
      </StackPanel>
      <TextBlock x:Name="HotkeyStatusText" Margin="110,4,0,0" Opacity="0.7" TextWrapping="Wrap" />

      <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
        <TextBlock x:Name="PlaceLabel" Width="110" VerticalAlignment="Center" Text="Folder" />
        <Button x:Name="ExploreButton" Padding="12,4" Content="Explore to" ToolTip="Opens the vault folder (of a server vault: its copy on this computer) in File Explorer" Click="ExploreButton_Click" />
        <Button x:Name="MoveToServerButton" Margin="8,0,0,0" Padding="12,4" Content="Move to server..." ToolTip="Copies the vault to the server, as it is: it is then synced by kofrenot. Its folder is left as it was" Click="MoveToServerButton_Click" />
        <Button x:Name="DeleteFromServerButton" Margin="8,0,0,0" Padding="12,4" Content="Delete from server..." ToolTip="Moves the vault to the server's trash, for every device" Click="DeleteFromServerButton_Click" />
      </StackPanel>

      <TextBlock x:Name="StatusText" Margin="0,10,0,0" Opacity="0.7" TextWrapping="Wrap" />

      <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
        <TextBlock x:Name="RememberedText" VerticalAlignment="Center" />
        <Button x:Name="ForgetButton"
                Margin="12,0,0,0"
                Padding="12,4"
                Content="Forget"
                ToolTip="The pass phrase will be asked when the vault is opened again"
                Click="ForgetButton_Click" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
