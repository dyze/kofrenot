<Window x:Class="Kofrenot.UI.Views.CreationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kofrenot.UI.Views"
        Title="kofrenot"
        Icon="/Assets/kofrenot.ico"
        Width="540"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SourceInitialized="Window_SourceInitialized"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
  <!-- The creation screen, in steps: each new node (its type, and its content for a note), then
       the link. Nothing is added before the last step. Enter or Ctrl+Enter: Next / Add (in the
       content, Enter adds a line); Esc cancels the whole creation. -->
  <Grid Margin="20,18,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" />
      <TextBlock x:Name="StepText" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.6" />
    </Grid>

    <!-- A new node: its name, its type, and the content of a note. -->
    <StackPanel x:Name="NodePanel" Grid.Row="1" Margin="0,14,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="160" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="NodeName" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock FontSize="12" Opacity="0.7" Text="New node" />
        </StackPanel>
        <ComboBox x:Name="TypeBox"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  DisplayMemberPath="Name"
                  SelectionChanged="TypeBox_SelectionChanged" />
      </Grid>

      <local:MarkdownBox x:Name="ContentBox" Height="220" Margin="0,12,0,0" Visibility="Collapsed" />

      <!-- A name that exists already, and the nodes that have it. -->
      <TextBlock x:Name="WarningText"
                 Margin="0,14,0,0"
                 Foreground="{DynamicResource SystemFillColorCautionBrush}"
                 TextWrapping="Wrap" />
      <ItemsControl x:Name="ExistingList" Margin="16,4,0,0" Opacity="0.8" />
    </StackPanel>

    <!-- The link: its two nodes (new ones were set in their steps), and its type. -->
    <Grid x:Name="LinkPanel" Grid.Row="1" Margin="0,14,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="160" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.ColumnSpan="2">
        <TextBlock x:Name="LeftName" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="LeftInfo" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock Grid.Row="1" Margin="16,10,0,0" VerticalAlignment="Center" Opacity="0.7" Text="Link type" />
      <ComboBox x:Name="LinkTypeBox"
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,10,0,0"
                DisplayMemberPath="Name"
                SelectionChanged="LinkTypeBox_SelectionChanged" />
      <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
        <TextBlock x:Name="RightName" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="RightInfo" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>

    <TextBlock x:Name="StatusText"
               Grid.Row="2"
               Margin="0,14,0,0"
               Opacity="0.8"
               TextWrapping="Wrap" />

    <StackPanel Grid.Row="3"
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
      <Button x:Name="BackButton"
              MinWidth="90"
              Margin="0,0,8,0"
              Padding="12,4"
              Content="Back"
              Click="BackButton_Click" />
      <Button x:Name="NextButton"
              MinWidth="90"
              Padding="12,4"
              IsDefault="True"
              Click="NextButton_Click" />
      <Button MinWidth="90"
              Margin="8,0,0,0"
              Padding="12,4"
              Content="Cancel"
              Click="CancelButton_Click" />
    </StackPanel>
  </Grid>
</Window>
