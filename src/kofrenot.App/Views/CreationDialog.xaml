<Window x:Class="Kofrenot.UI.Views.CreationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="kofrenot"
        Icon="/Assets/kofrenot.ico"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        SourceInitialized="Window_SourceInitialized">
  <!-- The creation screen: the node or link to add, the types still to choose, and what exists
       already. Enter adds, Esc cancels. -->
  <Grid Margin="20,18,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="160" />
    </Grid.ColumnDefinitions>

    <TextBlock x:Name="TitleText" Grid.ColumnSpan="2" FontSize="18" FontWeight="SemiBold" />

    <!-- The node, or the link's left side: its name, and its type when it is new. -->
    <StackPanel Grid.Row="1" Margin="0,14,0,0" VerticalAlignment="Center">
      <TextBlock x:Name="LeftName" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="LeftInfo" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
    </StackPanel>
    <ComboBox x:Name="LeftTypeBox"
              Grid.Row="1"
              Grid.Column="1"
              Margin="0,14,0,0"
              VerticalAlignment="Center"
              DisplayMemberPath="Name"
              SelectionChanged="LeftTypeBox_SelectionChanged" />

    <TextBlock x:Name="LinkLabel"
               Grid.Row="2"
               Margin="16,10,0,0"
               VerticalAlignment="Center"
               Opacity="0.7"
               Text="Link type" />
    <ComboBox x:Name="LinkTypeBox"
              Grid.Row="2"
              Grid.Column="1"
              Margin="0,10,0,0"
              DisplayMemberPath="Name"
              SelectionChanged="LinkTypeBox_SelectionChanged" />

    <StackPanel x:Name="RightPanel" Grid.Row="3" Margin="0,10,0,0" VerticalAlignment="Center">
      <TextBlock x:Name="RightName" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="RightInfo" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
    </StackPanel>
    <ComboBox x:Name="RightTypeBox"
              Grid.Row="3"
              Grid.Column="1"
              Margin="0,10,0,0"
              VerticalAlignment="Center"
              DisplayMemberPath="Name"
              SelectionChanged="RightTypeBox_SelectionChanged" />

    <!-- A name that exists already, and the nodes that have it. -->
    <TextBlock x:Name="WarningText"
               Grid.Row="4"
               Grid.ColumnSpan="2"
               Margin="0,14,0,0"
               Foreground="{DynamicResource SystemFillColorCautionBrush}"
               TextWrapping="Wrap" />
    <ItemsControl x:Name="ExistingList" Grid.Row="5" Grid.ColumnSpan="2" Margin="16,4,0,0" Opacity="0.8" />

    <TextBlock x:Name="StatusText"
               Grid.Row="6"
               Grid.ColumnSpan="2"
               Margin="0,14,0,0"
               Opacity="0.8"
               TextWrapping="Wrap" />

    <StackPanel Grid.Row="7"
                Grid.ColumnSpan="2"
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
      <Button x:Name="AddButton"
              MinWidth="90"
              Padding="12,4"
              Content="Add"
              IsDefault="True"
              Click="AddButton_Click" />
      <Button MinWidth="90"
              Margin="8,0,0,0"
              Padding="12,4"
              Content="Cancel"
              IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
