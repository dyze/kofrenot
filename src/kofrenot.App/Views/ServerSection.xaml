<UserControl x:Class="Kofrenot.UI.Views.ServerSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kofrenot.UI.Views">
  <!-- Settings > Server: the account on a Kofre server that keeps the server vaults. One account
       for this kofrenot; its password signs in, and only the session is kept on this computer. -->
  <StackPanel Margin="0,10,0,0">
    <TextBlock Opacity="0.7"
               TextWrapping="Wrap"
               Text="A Kofre server keeps your server vaults and syncs them across your devices. Its admin approves new accounts. The password signs in; the account's pass phrase opens your server vaults and never leaves this computer, so the server cannot read them." />

    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
      <TextBlock Width="110" VerticalAlignment="Center" Text="Server" />
      <TextBox x:Name="ServerBox" Width="280" ToolTip="The server's address, as https://kofre.example.org" />
    </StackPanel>

    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
      <TextBlock Width="110" VerticalAlignment="Center" Text="Email" />
      <TextBox x:Name="EmailBox" Width="280" />
    </StackPanel>

    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
      <TextBlock Width="110" VerticalAlignment="Center" Text="Password" />
      <local:SecretBox x:Name="PasswordBox" Width="280" ToolTip="At least 10 characters. Not kept on this computer." />
    </StackPanel>

    <StackPanel Margin="110,10,0,0" Orientation="Horizontal">
      <Button x:Name="SignInButton" Padding="12,4" Content="Sign in" Click="SignInButton_Click" />
      <Button x:Name="SignUpButton" Margin="8,0,0,0" Padding="12,4" Content="Sign up" ToolTip="Creates an account: you can sign in once the server's admin approves it" Click="SignUpButton_Click" />
      <Button x:Name="SignOutButton" Margin="8,0,0,0" Padding="12,4" Content="Sign out" ToolTip="Forgets the session on this computer: the server vaults stay, synced again once signed in" Click="SignOutButton_Click" />
    </StackPanel>

    <TextBlock x:Name="StatusText" Margin="110,10,0,0" Opacity="0.8" TextWrapping="Wrap" />

    <TextBlock x:Name="KeyText"
               Margin="110,6,0,0"
               Opacity="0.8"
               TextWrapping="Wrap"
               ToolTip="Read it to whoever shares a vault with you: they see the same, or the server gave them another key" />

    <TextBlock x:Name="TooOldText"
               Margin="110,6,0,0"
               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
               TextWrapping="Wrap"
               Visibility="Collapsed" />

    <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
      <TextBlock Width="110" VerticalAlignment="Center" Text="Password" />
      <Button x:Name="ChangePasswordButton"
              Padding="12,4"
              Content="Change..."
              ToolTip="The password that signs in to the server: your other devices are then signed out"
              ToolTipService.ShowOnDisabled="True"
              Click="ChangePasswordButton_Click" />
    </StackPanel>

    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
      <TextBlock Width="110" VerticalAlignment="Center" Text="Pass phrase" />
      <!-- Choose... while the account has none, then Change...: set by the code behind. -->
      <Button x:Name="PassPhraseButton"
              Padding="12,4"
              ToolTipService.ShowOnDisabled="True"
              Click="PassPhraseButton_Click" />
    </StackPanel>
  </StackPanel>
</UserControl>
