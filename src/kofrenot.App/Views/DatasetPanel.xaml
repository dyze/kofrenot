<UserControl x:Class="Kofrenot.UI.Views.DatasetPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kofrenot.UI.Views">
  <!-- The file of a dataset, in its details, shown by its viewer (DatasetView) when it has one.
       Import (Ctrl+I) or a file dropped here adds a new version, Export (Ctrl+E) or dragging the
       file out saves it elsewhere. Files imported on two devices before they synced show a
       conflict: keep one. -->
  <UserControl.Resources>
    <ResourceDictionary Source="SharedStyles.xaml" />
  </UserControl.Resources>

  <Border Margin="2,14,0,0"
          Padding="12,10"
          AllowDrop="True"
          Background="{DynamicResource ControlFillColorDefaultBrush}"
          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="6"
          DragOver="Zone_DragOver"
          Drop="Zone_Drop">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- The file, with its thumbnail or type icon: drag it out to export it. -->
      <StackPanel x:Name="FileRow"
                  Grid.ColumnSpan="2"
                  Background="Transparent"
                  Orientation="Horizontal"
                  MouseLeftButtonDown="FileRow_MouseLeftButtonDown"
                  MouseMove="FileRow_MouseMove">
        <local:NodeVisualView x:Name="HeaderVisual" Width="48" Height="48" Margin="0,0,12,0" VerticalAlignment="Center" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="FileNameText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="FileInfoText" Style="{StaticResource SecondaryText}" />
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
        <Button x:Name="ImportButton"
                Padding="10,3"
                Focusable="False"
                Content="Import…"
                ToolTip="Import a file as the new version (Ctrl+I)"
                Click="Import_Click" />
        <Button x:Name="ExportButton"
                Margin="6,0,0,0"
                Padding="10,3"
                Focusable="False"
                Content="Export…"
                ToolTip="Save the file elsewhere (Ctrl+E)"
                Click="Export_Click" />
      </StackPanel>

      <StackPanel x:Name="ConflictPanel" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0" Visibility="Collapsed">
        <TextBlock Foreground="{DynamicResource SystemFillColorCautionBrush}"
                   TextWrapping="Wrap"
                   Text="Imported on two devices before they synced. Keep:" />
        <ItemsControl x:Name="ConflictVersions">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Margin="0,4,8,0"
                      Padding="10,2"
                      Focusable="False"
                      Content="{Binding Label}"
                      IsEnabled="{Binding CanKeep}"
                      Click="KeepVersion_Click" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <TextBlock x:Name="StatusText"
                 Grid.Row="2"
                 Grid.ColumnSpan="3"
                 Margin="0,8,0,0"
                 Style="{StaticResource CaptionText}"
                 TextWrapping="Wrap" />

      <local:DatasetView x:Name="View" Grid.Row="3" Grid.ColumnSpan="3" Visibility="Collapsed" />
    </Grid>
  </Border>
</UserControl>
