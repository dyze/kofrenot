<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Kofrenot.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Coverage of Core, enforced on every `dotnet test` (coverlet.msbuild). -->
  <PropertyGroup>
    <CollectCoverage>true</CollectCoverage>
    <Include>[kofrenot.Core]*</Include>
    <Threshold>95</Threshold>
    <ThresholdType>line</ThresholdType>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <CoverletOutput>$(ArtifactsPath)/coverage/</CoverletOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.msbuild" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- The tests cover all of Core, so every Core namespace is imported once here. -->
    <Using Include="Kofrenot.Core" />
    <Using Include="Kofrenot.Core.Graph" />
    <Using Include="Kofrenot.Core.Input" />
    <Using Include="Kofrenot.Core.Logging" />
    <Using Include="Kofrenot.Core.Placement" />
    <Using Include="Kofrenot.Core.Settings" />
    <Using Include="Kofrenot.Core.Storage" />
    <Using Include="Kofrenot.Core.Updates" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\kofrenot.Core\kofrenot.Core.csproj" />
  </ItemGroup>

</Project>
